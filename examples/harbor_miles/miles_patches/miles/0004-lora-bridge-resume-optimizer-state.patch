+#
+# harbor_miles 0004 (bridge-LoRA resume): Megatron's DistributedOptimizer.state_dict() deliberately omits the
+# per-parameter state (fp32 master shards, exp_avg, exp_avg_sq); Megatron saves it separately
+# (save_parameter_state / sharded_state_dict), and its load_state_dict() allocates the moments with torch.empty,
+# "to be overwritten by load_parameter_state()". The LoRA checkpoint saved only state_dict(), so every resume
+# stepped Adam on uninitialized memory (NaN adapters, served to the engines). The fp32 masters were also stale:
+# they were refreshed from the model BEFORE the adapter was copied in, so the first step() wrote
+# fresh-init + one update over the loaded adapter.
+# Now each rank saves its own shards (same layout on resume, matched by parameter name) in
+# optimizer_state_rank{r}.pt; on load the masters are refreshed after the adapter copy and then overwritten by the
+# saved fp32 masters, the restored state is verified to equal the saved one exactly (masters, moments, step, adapter;
+# bf16(master) == adapter), and every optimizer load ends in assert_optimizer_state_finite (finite masters/moments,
+# exp_avg_sq >= 0). A checkpoint WITHOUT optimizer state (saved by pre-fix code, or pruned) refuses to resume.
+
+OPTIMIZER_STATE_FILE = "optimizer_state_rank{rank}.pt"
+LORA_TRAINING_STATE_VERSION = 2
+# Keep the (large) optimizer-state shards of the newest N checkpoints only (resume uses the newest); older iterations
+# keep adapter + training state (weights-only eval works; resuming from them fails loudly). 0 keeps all.
+KEEP_OPTIMIZER_STATE_ENV = "MILES_LORA_KEEP_OPTIMIZER_STATE"
+
+
+def _optimizer_children(optimizer: Any) -> list:
+    return list(getattr(optimizer, "chained_optimizers", None) or [optimizer])
+
+
+def _is_distributed_optimizer(child: Any) -> bool:
+    return hasattr(child, "gbuf_ranges") and hasattr(child, "_get_main_param_and_optimizer_states")
+
+
+def _iter_distopt_params(child: Any):
+    """(model_param, param_range_map) in the DistributedOptimizer's own (deterministic) shard order."""
+    for gbuf_range_maps in child.gbuf_ranges:
+        for gbuf_range_map_for_all_buckets in gbuf_range_maps.values():
+            for gbuf_range_map in gbuf_range_map_for_all_buckets:
+                yield from gbuf_range_map["param_map"].items()
+
+
+def _param_names(model: Sequence[torch.nn.Module]) -> dict[int, str]:
+    return {id(param): name for chunk in model for name, param in chunk.named_parameters()}
+
+
+def _optimizer_param_state(model: Sequence[torch.nn.Module], optimizer: Any) -> list[dict | None]:
+    """This rank's fp32 master shards + Adam moments, per chained DistributedOptimizer, keyed by parameter name."""
+    names = _param_names(model)
+    out: list[dict | None] = []
+    for child in _optimizer_children(optimizer):
+        if not _is_distributed_optimizer(child):
+            out.append(None)  # non-distributed optimizers keep their state in state_dict()
+            continue
+        entries = {}
+        for model_param, range_map in _iter_distopt_params(child):
+            tensors = child._get_main_param_and_optimizer_states(model_param)
+            entry = {k: v.detach().to("cpu", copy=True) for k, v in tensors.items() if torch.is_tensor(v)}
+            entry["_range"] = (range_map["param"].start, range_map["param"].end)
+            entries[names[id(model_param)]] = entry
+        out.append(entries)
+    return out
+
+
+def _restore_optimizer_param_state(model: Sequence[torch.nn.Module], optimizer: Any, saved: list) -> int:
+    names = _param_names(model)
+    children = _optimizer_children(optimizer)
+    if len(saved) != len(children):
+        raise RuntimeError(
+            f"optimizer state holds {len(saved)} chained optimizers, this run has {len(children)}: "
+            "the checkpoint was saved under a different optimizer/parallel layout"
+        )
+    restored = 0
+    for idx, (child, entries) in enumerate(zip(children, saved, strict=True)):
+        if not _is_distributed_optimizer(child):
+            continue
+        if entries is None:
+            raise RuntimeError(f"chained optimizer {idx} is distributed but the checkpoint has no state for it")
+        for model_param, range_map in _iter_distopt_params(child):
+            name = names[id(model_param)]
+            entry = entries.get(name)
+            if entry is None:
+                raise RuntimeError(f"optimizer state has no entry for {name}: different model or layout")
+            want = (range_map["param"].start, range_map["param"].end)
+            if tuple(entry["_range"]) != want:
+                raise RuntimeError(
+                    f"optimizer shard of {name} covers {tuple(entry['_range'])}, this rank owns {want}: "
+                    "the checkpoint was saved under a different parallel layout"
+                )
+            dst = child._get_main_param_and_optimizer_states(model_param)
+            src = {}
+            for key, cur in dst.items():
+                if not torch.is_tensor(cur):
+                    src[key] = cur
+                    continue
+                if key not in entry:
+                    raise RuntimeError(f"optimizer state of {name} lacks {key!r}")
+                if entry[key].numel() != cur.numel():
+                    raise RuntimeError(f"optimizer state {name}.{key}: {entry[key].numel()} vs {cur.numel()} elements")
+                src[key] = entry[key].to(device=cur.device, dtype=cur.dtype).view_as(cur)
+            child._set_main_param_and_optimizer_states(model_param, src)
+            restored += 1
+    return restored
+
+
+def _verify_restored_param_state(model: Sequence[torch.nn.Module], optimizer: Any, saved: list, steps: list) -> str:
+    """Exact check after a restore: live fp32 masters / moments == the saved tensors, bf16(master) == the loaded
+    adapter shard (Bug A), Adam step == the saved step. Cheap at LoRA size. Raises on any mismatch."""
+    names = _param_names(model)
+    n_tensors = 0
+    problems = []
+    for child, entries in zip(_optimizer_children(optimizer), saved, strict=True):
+        if not _is_distributed_optimizer(child):
+            continue
+        for model_param, range_map in _iter_distopt_params(child):
+            name = names[id(model_param)]
+            live = child._get_main_param_and_optimizer_states(model_param)
+            for key, value in live.items():
+                if torch.is_tensor(value) and key in entries[name]:
+                    n_tensors += 1
+                    if not torch.equal(value.detach().cpu().view(-1), entries[name][key].view(-1).to(value.dtype)):
+                        problems.append(f"{name}.{key} != saved")
+            shard = model_param.detach().view(-1)[range_map["param"].start : range_map["param"].end]
+            if not torch.equal(live["param"].detach().view(-1).to(shard.dtype), shard):
+                problems.append(f"{name}: bf16(master) != adapter")
+    live_steps = sorted({g.get("step") for c in _optimizer_children(optimizer) for g in getattr(c, "param_groups", [])
+                         if "step" in g} - {None})
+    if steps and live_steps and live_steps != steps:  # torch Adam keeps its step in the state (compared above)
+        problems.append(f"Adam step {live_steps} != saved {steps}")
+    if problems:
+        raise RuntimeError(f"LoRA resume verification FAILED: {len(problems)} mismatches, e.g. {problems[:6]}")
+    return f"{n_tensors} tensors exact, bf16(master) == adapter, Adam step {live_steps or steps}"
+
+
+def assert_optimizer_state_finite(
+    optimizer: Any, where: str, model: Sequence[torch.nn.Module] | None = None
+) -> None:
+    """Collective. Fail if any master param or optimizer state tensor is non-finite, or exp_avg_sq < 0, on any rank
+    (and, with ``model``, any trainable parameter). Called after every optimizer load and (LoRA) every step."""
+    labels: list[str] = []
+    flags: list[torch.Tensor] = []
+    device = torch.cuda.current_device() if torch.cuda.is_available() else "cpu"
+    for idx, child in enumerate(_optimizer_children(optimizer)):
+        inner = getattr(child, "optimizer", None)
+        if inner is None or not hasattr(inner, "param_groups"):
+            continue
+        for gi, group in enumerate(inner.param_groups):
+            for pi, param in enumerate(group["params"]):
+                tensors = [("master", param.detach())]
+                tensors += [(k, v) for k, v in inner.state.get(param, {}).items() if torch.is_tensor(v)]
+                for key, value in tensors:
+                    if value.numel() == 0 or not value.is_floating_point():
+                        continue
+                    ok = torch.isfinite(value).all()
+                    if key == "exp_avg_sq":
+                        ok = ok & (value >= 0).all()
+                    labels.append(f"opt{idx}.group{gi}.param{pi}.{key}")
+                    flags.append(ok.to(device))
+    if model is not None:
+        for chunk in model:
+            for name, param in chunk.named_parameters():
+                if param.requires_grad and param.numel() > 0:
+                    labels.append(name)
+                    flags.append(torch.isfinite(param.detach()).all().to(device))
+    local = torch.stack(flags) if flags else torch.ones(1, dtype=torch.bool, device=device)
+    ok_all = local.all().to(torch.int32).reshape(1)
+    if dist.is_initialized():
+        dist.all_reduce(ok_all, op=dist.ReduceOp.MIN)
+    if int(ok_all.item()) == 1:
+        return
+    bad = [labels[i] for i, flag in enumerate(local.tolist()) if not flag] if flags else []
+    rank = dist.get_rank() if dist.is_initialized() else 0
+    msg = (
+        f"FATAL ({where}): non-finite optimizer/adapter state or negative exp_avg_sq; rank {rank}: "
+        f"{len(bad)} bad tensors {bad[:12]}{' ...' if len(bad) > 12 else ''}. Refusing to continue (a NaN policy "
+        "would be saved and served)."
+    )
+    logger.error(msg)
+    raise RuntimeError(msg)
+
+
+def _prune_optimizer_state(save_dir: Path, rank: int) -> None:
+    keep = int(os.environ.get(KEEP_OPTIMIZER_STATE_ENV, "2"))
+    if keep <= 0:
+        return
+    pattern = f"iter_*/adapter/{OPTIMIZER_STATE_FILE.format(rank=rank)}"
+    files = sorted(save_dir.parent.parent.glob(pattern), key=lambda p: p.parent.parent.name)
+    for old in files[:-keep]:
+        try:
+            old.unlink()
+        except OSError:
+            logger.warning(f"could not prune {old}", exc_info=True)
 
 
