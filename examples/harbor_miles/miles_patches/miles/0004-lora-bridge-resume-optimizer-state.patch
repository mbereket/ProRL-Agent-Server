+def _restore_param_state(model: Sequence[torch.nn.Module], optimizer: Any, adapter_dir: Path, optimizer_restored: bool) -> None:
+    """After optimizer.load_state_dict(): restore this rank's fp32 masters + Adam moments and verify them exactly.
+    A DistributedOptimizer's load_state_dict leaves torch.empty moments behind, so a checkpoint without
+    optimizer_state_rank*.pt (pre-fix code, or pruned) must not resume."""
+    if not optimizer_restored:
+        return
+    if not any(_is_distributed_optimizer(child) for child in _optimizer_children(optimizer)):
+        return  # non-distributed optimizers restore their state in load_state_dict()
+    rank = dist.get_rank() if dist.is_initialized() else 0
+    path = adapter_dir / OPTIMIZER_STATE_FILE.format(rank=rank)
+    have = torch.tensor([int(path.exists())], dtype=torch.int32, device=torch.cuda.current_device() if torch.cuda.is_available() else "cpu")
+    if dist.is_initialized():
+        dist.all_reduce(have, op=dist.ReduceOp.MIN)  # every rank restores, or every rank fails
+    if int(have.item()) != 1:
+        raise RuntimeError(
+            f"LoRA checkpoint {adapter_dir} has no optimizer state ({OPTIMIZER_STATE_FILE.format(rank='*')} missing on "
+            "at least one rank): it was saved by pre-fix code (harbor_miles miles_patches < 0004) or its optimizer "
+            "state was pruned, so its Adam moments cannot be restored. Start a fresh run (new RUN_NAME); the adapter "
+            "itself can still be evaluated (weights-only)."
+        )
+    saved = torch.load(path, map_location="cpu", weights_only=True)
+    n = _restore_optimizer_param_state(model, optimizer, saved)
+    ts = torch.load(adapter_dir / f"training_state_rank{rank}.pt", map_location="cpu", weights_only=False)
+    groups = ts["optimizer"] if isinstance(ts["optimizer"], list) else [ts["optimizer"]]
+    steps = sorted({g.get("step") for sd in groups for g in sd.get("optimizer", {}).get("param_groups", []) if "step" in g}
+                   - {None})
+    verdict = _verify_restored_param_state(model, optimizer, saved, steps)
+    logger.info(f"Restored fp32 master + Adam moments of {n} parameter shards from {path}; resume verification: {verdict}")
