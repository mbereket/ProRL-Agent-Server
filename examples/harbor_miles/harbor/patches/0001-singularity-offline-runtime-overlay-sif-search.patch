+# --- Cluster deployment knobs (all optional; unset = upstream behavior) -------
+#
+# HARBOR_SINGULARITY_BIN            singularity/apptainer executable (default "singularity").
+# HARBOR_SINGULARITY_SERVER_PYTHON  absolute path of a python (with fastapi+uvicorn) that is
+#                                   bind-mounted read-only into every container at the same
+#                                   path (HARBOR_SINGULARITY_RUNTIME_DIR). Enables the offline
+#                                   bootstrap: no apt/pip/network work at container start.
+# HARBOR_SINGULARITY_RUNTIME_DIR    host dir holding that python (bound at the same path, ro).
+# HARBOR_SINGULARITY_START_TIMEOUT_SEC  server health-check window (default 60; 600 offline).
+# HARBOR_SINGULARITY_OVERLAY_DIR    base dir for per-trial writable overlay directories
+#                                   (``--overlay``) instead of ``--writable-tmpfs`` (64 MB).
+# HARBOR_SINGULARITY_SIF_DIRS       colon-separated read-only dirs searched for a prebuilt SIF
+#                                   of the task's docker_image before pulling; both the Harbor
+#                                   cache name and the legacy ``ref-<sha256[:32]>.sif`` name.
+# HARBOR_SINGULARITY_FAKEROOT       "0" drops --fakeroot (default on).
+
+
+def _env_str(name: str) -> str | None:
+    value = os.environ.get(name, "").strip()
+    return value or None
+
+
+def _singularity_bin() -> str:
+    return _env_str("HARBOR_SINGULARITY_BIN") or "singularity"
+
+
+def _harbor_sif_name(docker_image: str) -> str:
+    image = docker_image if ":" in docker_image.rsplit("/", 1)[-1] else f"{docker_image}:latest"
+    return image.replace("/", "_").replace(":", "_") + ".sif"
+
+
+def _legacy_sif_name(docker_image: str) -> str:
+    return f"ref-{hashlib.sha256(docker_image.encode()).hexdigest()[:32]}.sif"
+
+
+def _descendants(root_pid: int) -> set[int]:
+    """All live descendants of ``root_pid`` (host PIDs, via /proc children)."""
+    seen: set[int] = set()
+    todo = [root_pid]
+    while todo:
+        pid = todo.pop()
+        try:
+            for task in Path(f"/proc/{pid}/task").iterdir():
+                try:
+                    for child in (task / "children").read_text().split():
+                        c = int(child)
+                        if c not in seen:
+                            seen.add(c)
+                            todo.append(c)
+                except (OSError, ValueError):
+                    pass
+        except OSError:
+            pass
+    return seen
+
+
+def _kill_pids(pids: set[int]) -> None:
+    import signal
+
+    for pid in pids:
+        try:
+            os.kill(pid, signal.SIGKILL)
+        except (ProcessLookupError, PermissionError):
+            pass
+
+
+def _force_rmtree(path: Path) -> None:
+    """rmtree that also removes entries a fakeroot container left without u+w."""
+
+    def _onerror(func, target, _exc):
+        try:
+            os.chmod(os.path.dirname(target), 0o700)
+            os.chmod(target, 0o700)
+            func(target)
+        except Exception:
+            pass
+
+    try:
+        shutil.rmtree(path, onerror=_onerror)
+    except Exception:
+        shutil.rmtree(path, ignore_errors=True)
+
+
+def find_prebuilt_sif(docker_image: str, extra_names: list[str] | None = None) -> Path | None:
+    """Look up a prebuilt SIF for ``docker_image`` in HARBOR_SINGULARITY_SIF_DIRS.
+
+    Names tried: Harbor's cache name, ``ref-<sha256(ref)[:32]>.sif``, then ``extra_names``
+    (e.g. ``<task dir>.sif`` for per-task image caches)."""
+    dirs = [d for d in (_env_str("HARBOR_SINGULARITY_SIF_DIRS") or "").split(":") if d]
+    names = []
+    for ref in (docker_image, f"{docker_image}:latest" if ":" not in docker_image.rsplit("/", 1)[-1] else None):
+        if ref:
+            names += [_harbor_sif_name(ref), _legacy_sif_name(ref)]
+    names.append(docker_image.replace("/", "_").replace(":", "_") + ".sif")  # untagged cache name
+    names += list(extra_names or [])
+    for d in dirs:
+        for name in names:
+            candidate = Path(d) / name
+            if candidate.is_file() and candidate.stat().st_size > 0:
+                return candidate
+    return None
+
