index 04f9644..6e72db5 100644
--- a/src/harbor/environments/singularity/server.py
+++ b/src/harbor/environments/singularity/server.py
@@ -373,12 +373,32 @@ def setup_apt_sources() -> None:
         logger.warning(f"Could not write {sources_file}: {e}")
 
 
+def setup_apt_unprivileged() -> None:
+    """Let apt work under --fakeroot without subuid mappings.
+
+    In a root-mapped user namespace only uid 0 is mapped, so apt's privilege drop
+    to the ``_apt`` sandbox user fails on its own lists/archives directories
+    ("Permission denied" on /var/lib/apt/lists/partial). Run apt's fetchers as
+    root instead (the container is the sandbox).
+    """
+    conf_dir = "/etc/apt/apt.conf.d"
+    if not os.path.isdir("/etc/apt"):
+        return
+    try:
+        os.makedirs(conf_dir, exist_ok=True)
+        with open(f"{conf_dir}/00-harbor-singularity-sandbox", "w") as f:
+            f.write('APT::Sandbox::User "root";\n')
+    except OSError as e:
+        logger.warning(f"Could not configure apt sandbox user: {e}")
+
+
 def setup_singularity_environment(workdir: str) -> None:
     """Run all Singularity environment setup."""
     setup_workdir(workdir)
     setup_dpkg_for_overlay()
     setup_common_directories()
     setup_fake_sudo()
+    setup_apt_unprivileged()
 
     try:
         setup_apt_sources()
