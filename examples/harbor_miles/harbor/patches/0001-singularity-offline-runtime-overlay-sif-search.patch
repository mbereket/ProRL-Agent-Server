diff --git a/src/harbor/environments/singularity/bootstrap_offline.sh b/src/harbor/environments/singularity/bootstrap_offline.sh
new file mode 100755
index 0000000..ebe25c6
--- /dev/null
+++ b/src/harbor/environments/singularity/bootstrap_offline.sh
@@ -0,0 +1,36 @@
+#!/bin/bash
+# Harbor singularity server bootstrap, offline variant.
+#
+# Selected by SingularityEnvironment when HARBOR_SINGULARITY_SERVER_PYTHON is
+# set: the server runs on a host-provided python (with fastapi+uvicorn) that is
+# bind-mounted read-only into the container, so container start does no apt,
+# pip or other network work (the stock bootstrap's apt-get update + pip install
+# per container start is slow and flaky at dozens of concurrent starts per node).
+# The task's environment/files/setup.sh still runs (sourced) before the server.
+# First arg is WORKDIR (container cwd), rest are server args.
+export WORKDIR="${1:-/app}"; shift
+export HARBOR_STAGING="/staging/env_files"
+mkdir -p "$WORKDIR" && cd "$WORKDIR"
+
+export TMUX_TMPDIR="${TMUX_TMPDIR:-/tmp/.harbor-tmux}"
+mkdir -p "$TMUX_TMPDIR"
+
+echo "[harbor] bootstrap (offline) start $(date +%T)" >&2
+if [ -f "$HARBOR_STAGING/setup.sh" ]; then
+  echo "[harbor] Running task setup.sh..." >&2
+  # shellcheck disable=SC1091
+  source "$HARBOR_STAGING/setup.sh"
+  echo "[harbor] setup.sh done $(date +%T)" >&2
+fi
+
+# -I (isolated): the image's PYTHONPATH/PYTHONHOME/user site must not leak into the server's own
+# interpreter (e.g. a repo-under-test's pydantic shadowing the server's). Commands the server runs
+# still get the image's environment unchanged.
+if [ -z "${HARBOR_SERVER_PYTHON:-}" ] || ! "$HARBOR_SERVER_PYTHON" -I -c "import uvicorn, fastapi" 2>/dev/null; then
+  echo "[harbor] FATAL: HARBOR_SERVER_PYTHON=${HARBOR_SERVER_PYTHON:-unset} has no uvicorn+fastapi" >&2
+  "${HARBOR_SERVER_PYTHON:-python3}" -I -c "import uvicorn, fastapi" >&2 || true
+  exit 1
+fi
+export HARBOR_PYTHON="$HARBOR_SERVER_PYTHON"
+echo "[harbor] starting server with $HARBOR_PYTHON -I $(date +%T)" >&2
+exec "$HARBOR_PYTHON" -I "$@"
