+async def _cancel_file_loop(cancel_dir: Path, interval: float = 15.0) -> None:
+    """Per-trial cancel by file (HARBOR_CANCEL_DIR). Operators often have file access (SFTP) but no shell on the node.
+
+    A file ``<cancel_dir>/<instance_id>`` cancels THIS server's in-flight /run trials of that task; ``ALL`` cancels every
+    in-flight trial. Cancelling takes the same path as /flush: the trial worker's process group gets SIGTERM, its
+    sandbox is torn down (SIGKILL after the grace period), and the caller gets exit_status "Flushed". Each server acts
+    on a file once and records ``<name>.done.<host>``, so later attempts of the same task are not affected.
+    """
+    import socket
+
+    host = socket.gethostname().split(".")[0]
+    cancel_dir.mkdir(parents=True, exist_ok=True)
+    logger.info("cancel-file trigger: watching %s", cancel_dir)
+    while True:
+        await asyncio.sleep(interval)
+        try:
+            names = [p.name for p in cancel_dir.iterdir() if p.is_file() and ".done." not in p.name]
+        except OSError:
+            continue
+        for name in names:
+            marker = cancel_dir / f"{name}.done.{host}"
+            if marker.exists():
+                continue
+            hits = [t for t, iid in list(_state.inflight_instance.items()) if name == "ALL" or iid == name]
+            for t in hits:
+                t.cancel()
+            logger.warning("cancel file %s: cancelling %d in-flight trial(s) on %s", name, len(hits), host)
+            try:
+                marker.write_text(
+                    f"cancelled {len(hits)} in-flight trial(s) at {datetime.now(timezone.utc).isoformat()}\n"
+                )
+            except OSError:
+                pass
+
+
+def _job_memory_cgroup() -> tuple[Path, bool] | None:
+    """The Slurm job's memory cgroup dir (walk up from this process to job_<SLURM_JOB_ID>) and whether it is cgroup v2."""
+    job = os.getenv("SLURM_JOB_ID", "")
+    try:
+        lines = Path("/proc/self/cgroup").read_text().splitlines()
+    except OSError:
+        return None
+    for line in lines:
+        _, ctrls, path = line.split(":", 2)
+        if ctrls == "":
+            base, v2, probe = Path("/sys/fs/cgroup" + path), True, "memory.max"
+        elif "memory" in ctrls.split(","):
+            base, v2, probe = Path(f"/sys/fs/cgroup/{ctrls}{path}"), False, "memory.limit_in_bytes"
+        else:
+            continue
+        d = base
+        while str(d) not in ("/", "/sys/fs/cgroup"):
+            if d.name == f"job_{job}" and (d / probe).exists():
+                return d, v2
+            d = d.parent
+        if (base / probe).exists():
+            return base, v2
+    return None
+
+
+def _cgroup_limit_and_unreclaimable(d: Path, v2: bool) -> tuple[int | None, int | None]:
+    """(limit, unreclaimable bytes = anon + shmem). Page cache is excluded: the kernel lets it fill a cgroup and reclaims
+    it under pressure, so memory.current near the limit is normal. shmem covers tmpfs files (e.g. a sandbox /tmp)."""
+    try:
+        raw = (d / ("memory.max" if v2 else "memory.limit_in_bytes")).read_text().strip()
+        limit = int(raw) if raw.isdigit() and int(raw) < (1 << 60) else None
+        stat = dict(line.split() for line in (d / "memory.stat").read_text().splitlines() if len(line.split()) == 2)
+    except (OSError, ValueError):
+        return None, None
+    keys = ("anon", "shmem") if v2 else ("total_rss", "total_shmem")
+    return limit, sum(int(stat.get(k, 0)) for k in keys)
+
+
+def _tree_rss(root: int) -> int:
+    page = os.sysconf("SC_PAGE_SIZE")
+    total = 0
+    for pid in {root} | _descendants(root):
+        try:
+            total += int(Path(f"/proc/{pid}/statm").read_text().split()[1]) * page
+        except (OSError, ValueError, IndexError):
+            pass
+    return total
+
+
+async def _mem_watchdog_loop(frac: float, interval: float = 5.0) -> None:
+    """Node memory watchdog (HARBOR_MEM_WATCHDOG_FRAC, default 0.8; 0 disables).
+
+    Sandboxes have no cgroup memory limit on HPC nodes, and one runaway analysis process filled a 1.2 TB job cgroup in
+    8 minutes and hung the whole job (dfw 19612902). When the job's unreclaimable memory (anon + shmem) reaches
+    ``frac`` of the job cgroup limit, the trial with the largest process-tree RSS is SIGKILLed at once (no grace period:
+    memory grows by GB/s) and its /run returns exit_status "Error: MemoryWatchdog" (= infra failure, excluded from the
+    loss). Then it waits 15 s for the memory to drop before checking again.
+    """
+    found = _job_memory_cgroup()
+    if found is None:
+        logger.warning("memory watchdog: no memory cgroup found; disabled")
+        return
+    d, v2 = found
+    limit, _ = _cgroup_limit_and_unreclaimable(d, v2)
+    if not limit:
+        logger.warning("memory watchdog: %s has no memory limit; disabled", d)
+        return
+    logger.info("memory watchdog: %s limit %.0f GB, kill threshold %.0f%%", d, limit / 2**30, 100 * frac)
+    while True:
+        await asyncio.sleep(interval)
+        limit, used = _cgroup_limit_and_unreclaimable(d, v2)
+        if not limit or used is None or used < frac * limit:
+            continue
+        sizes = {pgid: await asyncio.to_thread(_tree_rss, pgid) for pgid in list(_state.trial_pgids)}
+        if not sizes:
+            logger.error("MEMORY WATCHDOG: job memory %.0f of %.0f GB but no trial is running here", used / 2**30, limit / 2**30)
+            await asyncio.sleep(15)
+            continue
+        ranked = sorted(sizes.items(), key=lambda kv: kv[1], reverse=True)
+        pgid, rss = ranked[0]
+        task = _state.pgid_task.get(pgid)
+        iid = _state.inflight_instance.get(task) if task is not None else None
+        logger.error(
+            "MEMORY WATCHDOG: job anon+shmem %.0f of %.0f GB (>= %.0f%%): killing trial %s (worker pgid %d, tree RSS %.1f GB; "
+            "next largest %.1f GB)", used / 2**30, limit / 2**30, 100 * frac, iid, pgid, rss / 2**30,
+            ranked[1][1] / 2**30 if len(ranked) > 1 else 0.0,
+        )
+        if task is not None:
+            _state.watchdog_killed.add(task)
+        _sigkill_group_and_tree(pgid, _descendants(pgid))
+        if task is not None:
+            task.cancel()
+        await asyncio.sleep(15)
+
