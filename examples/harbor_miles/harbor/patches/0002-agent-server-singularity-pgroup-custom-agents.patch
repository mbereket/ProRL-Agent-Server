+_GRACE_SEC = float(os.getenv("HARBOR_TRIAL_STOP_GRACE_SEC", "45"))
+
+
+def _descendants(root_pid: int) -> set[int]:
+    seen: set[int] = set()
+    todo = [root_pid]
+    while todo:
+        pid = todo.pop()
+        try:
+            for task in Path(f"/proc/{pid}/task").iterdir():
+                try:
+                    for child in (task / "children").read_text().split():
+                        c = int(child)
+                        if c not in seen:
+                            seen.add(c)
+                            todo.append(c)
+                except (OSError, ValueError):
+                    pass
+        except OSError:
+            pass
+    return seen
+
+
+def _sigkill_group_and_tree(pgid: int, tree: set[int]) -> None:
+    try:
+        os.killpg(pgid, signal.SIGKILL)
+    except (ProcessLookupError, PermissionError):
+        pass
+    for pid in tree:
+        try:
+            os.kill(pid, signal.SIGKILL)
+        except (ProcessLookupError, PermissionError):
+            pass
+
+
+async def kill_process_group(proc: asyncio.subprocess.Process, grace_sec: float = _GRACE_SEC) -> None:
+    """Stop a trial worker: graceful first, forceful after ``grace_sec``.
+
+    SIGTERM goes to the worker only; it cancels its trial, whose teardown stops
+    the sandbox properly (apptainer then also unmounts its FUSE helpers and
+    removes the overlay). Whatever is still alive after the grace period (the
+    worker's group and every process that was in its tree) is SIGKILLed.
+    """
+    tree = _descendants(proc.pid)
+    try:
+        proc.send_signal(signal.SIGTERM)
+    except ProcessLookupError:
+        pass
+    try:
+        await asyncio.wait_for(proc.wait(), timeout=grace_sec)
+    except asyncio.TimeoutError:
+        pass
+    _sigkill_group_and_tree(proc.pid, tree | _descendants(proc.pid))
+    await proc.wait()
+
+
+async def kill_all_trial_groups(grace_sec: float = _GRACE_SEC) -> int:
+    """flush_all for process-based sandboxes: wait for the cancelled trials to tear
+    down gracefully (their /run tasks were just cancelled), then SIGKILL leftovers."""
+    deadline = asyncio.get_running_loop().time() + grace_sec + 5
+    while _state.trial_pgids and asyncio.get_running_loop().time() < deadline:
+        await asyncio.sleep(0.5)
+    killed = 0
+    for pgid in list(_state.trial_pgids):
+        _sigkill_group_and_tree(pgid, _descendants(pgid))
+        killed += 1
+        _state.trial_pgids.discard(pgid)
+    return killed
+
+
