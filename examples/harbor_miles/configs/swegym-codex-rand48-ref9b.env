HF_CKPT=${HM_SHARED}/hf_home/hub/models--Qwen--Qwen3.5-9B/snapshots/c202236235762e1c871ad0ccb60c8ee5ba337b9a
ARM=lora
LORA_RANK=32
LORA_ALPHA=64
LORA_SERVE=merged
LR=3e-5
LAYOUT=disagg
TRAIN_GPUS=4
TP=4
CP=1
MTPG=65536
ENGINE_TP=2
ENGINE_KV_TOKENS=1826914
MEMF=0.8
ASYNC=1
RBS=8
NS=8
MAX_STALENESS=2
ASYNC_CONCURRENCY=80
HM_SANDBOXES_PER_NODE=80
NUM_ROLLOUT=200
MAX_SEQ_LEN=65536
MAXRESP=8192
SAVE_INTERVAL=1
