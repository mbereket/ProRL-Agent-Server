# DIAG 27B de4 OVERFIT r3c: RESUME r3 (same RUN_NAME/run dir) from the last CLEAN checkpoint iter_4, with a FRESH optimizer.
# r3b's first post-resume step wrote NaN into lora_B of mlp gate_proj/up_proj in all 64 layers (10-51% of entries; iter_5), then
# everything (iter_6). Restoring optimizer state from training_state_rank*.pt (Miles lora/utils.py optimizer.load_state_dict on a
# Megatron (distributed) optimizer) is the suspect. Fix: --no-load-optim (Miles: keep the freshly initialized optimizer).
# The guarded mv below moves the corrupt iter_0000005/6 aside, so the driver's newest-complete-adapter rule picks iter_4.
# Everything else = r3b (6 tasks, 96k, 4-GPU TP4 + 3 TP4 engines, chunk 1024 + expandable_segments, LR 3e-5).
RUN_NAME=diag-de4-27b-overfit8-r3
HARBOR_TASKS_DIR=${HM_USER_ROOT}/miles/shared/tasks/de4-v1-k1-normal/harbor
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/diag-de4-27b-overfit6.txt
HARNESS=codex
HF_CKPT=${HM_USER_ROOT}/miles/models/Qwen3.8-27B
MODEL_TYPE=qwen3.8-27B
TITO_MODEL=qwen38small
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder
AGENT_MODEL_NAME=qwen38-27b
ARM=lora
LORA_RANK=32
LORA_ALPHA=64
LORA_SERVE=merged
NO_MTP=1
LR=3e-5
LAYOUT=disagg
TRAIN_GPUS=4
TP=4
CP=1
MTPG=98304
ENGINE_TP=4
ENGINE_KV_TOKENS=1814546
MEMF=0.85
ASYNC=1
RBS=8
NS=8
MAX_STALENESS=2
NUM_ROLLOUT=40
MAX_SEQ_LEN=98304
HARBOR_MAX_SEQ_LEN=98304
SAVE_INTERVAL=1
DROP_ZERO_STD=1
HM_OVERLONG_REWARD=zero
MILES_RESPONSES_DEFAULT_MAX_TOKENS=0
ASYNC_CONCURRENCY=78
HM_SANDBOXES_PER_NODE=40
HM_AGENT_TIMEOUT=3600
HM_REAPER_EXEMPT_MINS=90
HM_AGENT_TOOLS=codex
HM_REQUIRE_ENV=NVINF_API_KEY
AGENT_ENV='{"OMP_NUM_THREADS":"4","OPENBLAS_NUM_THREADS":"4","MKL_NUM_THREADS":"4","RCPP_PARALLEL_NUM_THREADS":"4"}'
HM_CHAIN_MAX=8
HM_SANDBOX_RESERVE_CPUS=16
LOGPROB_CHUNK=1024
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
EXTRA="--no-load-optim"
_hm_c="${HM_ROOT}/runs/${RUN_NAME}/ckpt"
{ for _it in iter_0000005 iter_0000006; do [ -d "${_hm_c}/${_it}" ] && mkdir -p "${_hm_c}/../corrupt-ckpt" && mv -n "${_hm_c}/${_it}" "${_hm_c}/../corrupt-ckpt/" && echo "[diag-cfg] $(hostname -s) moved corrupt ${_it} aside" >&2; done; } || true
echo "[diag-cfg] $(hostname -s) EXTRA=${EXTRA} TASK_IDS_FILE=${TASK_IDS_FILE} PYTORCH_CUDA_ALLOC_CONF=${PYTORCH_CUDA_ALLOC_CONF}" >&2
