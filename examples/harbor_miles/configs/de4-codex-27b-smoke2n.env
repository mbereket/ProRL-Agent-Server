# 27B de4 2-NODE TRAINING SMOKE = de4-codex-27b-lora-2n.env for 3 steps on 8 tasks under its own RUN_NAME, no chaining.
# Checks: the 2-node split (4 trainer GPUs + 3 TP4 engines across both nodes), NO_MTP with merged serving (the first weight
# push happens at startup), the de4 verifier/NVINF env and sandboxes on both nodes under training load, TITO on de4 codex
# sessions (perf N: special_token_type = non_assistant_text = 0, special_token_count == truncated_ratio), step times.
# Tasks: de4-v1-k1-normal-smoke8.txt (STAGING worker: 5 tasks GPT-5.6 solved 4/4 + 3 at 1-3/4; 27B base rates not in yet).
# Systems smoke, not a learning test: zero-variance groups are kept (DROP_ZERO_STD=0), so every step has its 8 x 8.
source "${HM_EXAMPLE_DIR}/configs/de4-codex-27b-lora-2n.env"
RUN_NAME=de4-codex-27b-smoke2n-r1
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/de4-v1-k1-normal-smoke8.txt
NUM_ROLLOUT=3
SAVE_INTERVAL=1
DROP_ZERO_STD=0
HM_CHAIN_MAX=0
# Smoke default (coordinator): short agent timeout so one straggler cannot hold a plumbing check (de4 task default 3600 s).
HM_AGENT_TIMEOUT=900
HM_SANDBOX_RESERVE_CPUS=16
