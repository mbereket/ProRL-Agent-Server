# P1 scale arm, 2 nodes, matched to Path A swegym-rand48-lora-2node.yaml: node 0 trainer TP2 x CP2 x DP2 (32768 tok/GPU,
# 64k cap), node 1 four TP2 engines; Harbor agent servers + 48 sandboxes on BOTH nodes (least-loaded dispatch);
# 16 tasks x 8 per step; otherwise identical to swegym-codex-rand48-lora-1n.env.
RUN_NAME=swegym-codex-rand48-lora-2n
HARBOR_TASKS_DIR=${HM_SHARED}/tasks/swegym-lite-v3/harbor
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/swegym-rand48-s0.txt
HARNESS=codex
HF_CKPT=${HM_SHARED}/hf_home/hub/models--Qwen--Qwen3.5-9B/snapshots/c202236235762e1c871ad0ccb60c8ee5ba337b9a
ARM=lora
LORA_RANK=32
LORA_ALPHA=64
LR=1e-5
LAYOUT=disagg
TRAIN_GPUS=8
TP=2
CP=2
MTPG=32768
ENGINE_TP=2
MEMF=0.8
ASYNC=1
RBS=16
NS=8
MAX_STALENESS=2
NUM_ROLLOUT=200
MAX_SEQ_LEN=65536
MAXRESP=8192
SAVE_INTERVAL=2
DROP_ZERO_STD=1
HM_OVERLONG_REWARD=zero
EVAL_INTERVAL=5
EVAL_N=2
EVAL_NAME=train48
HM_SANDBOXES_PER_NODE=48
HM_AGENT_TIMEOUT=1800
HM_REAPER_EXEMPT_MINS=60
HARBOR_MAX_SEQ_LEN=65536
HM_AGENT_TOOLS=codex
