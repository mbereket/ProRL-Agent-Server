# Learning demonstration: Miles LoRA GRPO, fully async, on the 8 BBH-MCP overfit tasks (opencode +
# MCP Jupyter tools, GLM-5.2 judge reward), 1 hel node: 4 trainer GPUs (TP2 x CP2, 64k trajectories)
# + 4 SGLang engines (TP1), 32 sandboxes on the node. Chained 4 h interactive jobs resume from ckpt/.
RUN_NAME=learn-bbh8-async-1n
HARBOR_TASKS_DIR=${HM_SHARED}/tasks/bbh-mcp-train-v1/harbor
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/bbh-overfit8.txt
AGENT_IMPORT_PATH=harbor_miles_agents.opencode_agents:BbhOpenCode
HF_CKPT=${HM_SHARED}/hf_home/hub/models--Qwen--Qwen3.5-9B/snapshots/c202236235762e1c871ad0ccb60c8ee5ba337b9a
ARM=lora
LORA_RANK=32
LORA_ALPHA=32
LR=1e-5
LAYOUT=disagg
TRAIN_GPUS=4
TP=2
CP=2
MTPG=32768
ENGINE_TP=1
MEMF=0.8
ASYNC=1
RBS=4
NS=8
ASYNC_CONCURRENCY=32
MAX_STALENESS=2
NUM_ROLLOUT=200
MAX_SEQ_LEN=65536
MAXRESP=8192
SAVE_INTERVAL=4
EXTRA="--log-probs-chunk-size 4096"
HM_SANDBOXES_PER_NODE=36
HM_AGENT_TIMEOUT=2700
HM_REAPER_EXEMPT_MINS=60
