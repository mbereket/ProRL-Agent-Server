# QWEN27B LR-1e-4 HEDGE on 2 NODES (coordinator 07:2x, P0): identical to DIAG's main r3 (diag-de4-27b-overfit8-2n-r3.env, miles-diag
# 7f76aa95; dfw 19612545, LR 3e-5) except LR 1e-4, RUN_NAME, and the allocator setting going in via Miles --train-env-vars
# (trainer workers only, set at process start = before CUDA init) instead of a job-wide export (DIAG's r3 also hands it to SGLang).
# Same 8 tasks (q27-de4-overfit8.txt == diag-de4-27b-overfit8.txt), 96k, NO_MTP, merged, LoRA r32/a64, GRPO, ZV dropped, overlong 0.
# Layout: 4-GPU TP4/CP1 trainer (98304 tok/GPU, logprob chunk 1024, expandable segments; STACK REAL 96k 7.45k tok/s, 77.2 GB) +
# 3 TP4 engines over 2 nodes, 78 in flight (26/engine), async staleness <= 2, CPU reserve 16. Path B >= 1fdfa6d6 (per-trial cancel:
# empty file RUN_DIR/cancel/<instance_id>). Watch the 9B failure mode at 1e-4: stop if mean response tokens fall >20% with no reward gain.
RUN_NAME=q27-de4-overfit8-2n-lr1e4
HARBOR_TASKS_DIR=${HM_USER_ROOT}/miles/shared/tasks/de4-v1-k1-normal/harbor
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/q27-de4-overfit8.txt
HARNESS=codex
HF_CKPT=${HM_USER_ROOT}/miles/models/Qwen3.8-27B
MODEL_TYPE=qwen3.8-27B
TITO_MODEL=qwen38small
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder
AGENT_MODEL_NAME=qwen38-27b
ARM=lora
LORA_RANK=32
LORA_ALPHA=64
LORA_SERVE=merged
NO_MTP=1
LR=1e-4
LAYOUT=disagg
TRAIN_GPUS=4
TP=4
CP=1
MTPG=98304
ENGINE_TP=4
ENGINE_KV_TOKENS=1814546
MEMF=0.85
ASYNC=1
RBS=8
NS=8
MAX_STALENESS=2
NUM_ROLLOUT=40
MAX_SEQ_LEN=98304
HARBOR_MAX_SEQ_LEN=98304
SAVE_INTERVAL=1
DROP_ZERO_STD=1
HM_OVERLONG_REWARD=zero
MILES_RESPONSES_DEFAULT_MAX_TOKENS=0
ASYNC_CONCURRENCY=78
HM_SANDBOXES_PER_NODE=40
HM_AGENT_TIMEOUT=3600
HM_REAPER_EXEMPT_MINS=90
HM_AGENT_TOOLS=codex
HM_REQUIRE_ENV=NVINF_API_KEY
AGENT_ENV='{"OMP_NUM_THREADS":"4","OPENBLAS_NUM_THREADS":"4","MKL_NUM_THREADS":"4","RCPP_PARALLEL_NUM_THREADS":"4"}'
HM_CHAIN_MAX=8
HM_SANDBOX_RESERVE_CPUS=16
LOGPROB_CHUNK=1024
EXTRA='--train-env-vars {"PYTORCH_CUDA_ALLOC_CONF":"expandable_segments:True"}'
