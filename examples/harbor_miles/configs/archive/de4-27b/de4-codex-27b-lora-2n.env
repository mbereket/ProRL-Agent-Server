# 27B LoRA RL on de4, 2 NODES: = de4-codex-27b-lora-1n.env except the layout. Trainer 4 GPUs TP4 on node 0 + THREE SGLang TP4
# engines (node 0 GPUs 4-7, node 1 GPUs 0-3 and 4-7), 3 x 26 in flight, sandboxes on both nodes (least-loaded dispatch).
# Same RUN_NAME as the 1n config, so a run can move between 1 and 2 nodes at a chain boundary (resume is layout-independent).
# PROVISIONAL cap/in-flight/batch until QWEN27B's "DE4 27B CONFIG". Submit with --nodes 2 (hel/dfw only; aws-iad is 1-node).
RUN_NAME=de4-codex-27b-lora-1n-r1
HARBOR_TASKS_DIR=${HM_USER_ROOT}/miles/shared/tasks/de4-v1-k1-normal/harbor
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/de4-v1-k1-normal-tasks.txt
HARNESS=codex
HF_CKPT=${HM_USER_ROOT}/miles/models/Qwen3.8-27B
MODEL_TYPE=qwen3.8-27B
TITO_MODEL=qwen38small
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder
AGENT_MODEL_NAME=qwen38-27b
ARM=lora
LORA_RANK=32
LORA_ALPHA=64
LORA_SERVE=merged
NO_MTP=1
LR=3e-5
LAYOUT=disagg
TRAIN_GPUS=4
TP=4
CP=1
MTPG=65536
ENGINE_TP=4
ENGINE_KV_TOKENS=1814546
MEMF=0.85
ASYNC=1
RBS=8
NS=8
MAX_STALENESS=2
NUM_ROLLOUT=200
MAX_SEQ_LEN=65536
HARBOR_MAX_SEQ_LEN=65536
SAVE_INTERVAL=1
DROP_ZERO_STD=1
HM_OVERLONG_REWARD=zero
MILES_RESPONSES_DEFAULT_MAX_TOKENS=0
ASYNC_CONCURRENCY=78
HM_SANDBOXES_PER_NODE=40
HM_AGENT_TIMEOUT=3600
HM_REAPER_EXEMPT_MINS=90
HM_AGENT_TOOLS=codex
HM_REQUIRE_ENV=NVINF_API_KEY
AGENT_ENV='{"OMP_NUM_THREADS":"4","OPENBLAS_NUM_THREADS":"4","MKL_NUM_THREADS":"4","RCPP_PARALLEL_NUM_THREADS":"4"}'
HM_CHAIN_MAX=8
