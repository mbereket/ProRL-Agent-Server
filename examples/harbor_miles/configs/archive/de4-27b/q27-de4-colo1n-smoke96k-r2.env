# Colocated 1-node 96k SMOKE, rerun with a short agent timeout and short tasks (coordinator 07:06: a smoke must never wait on one
# straggler; goal = the sleep/wake swap + train step + merged weight sync, not session outcomes). Same as q27-de4-colo1n-smoke96k.env except:
# HM_AGENT_TIMEOUT 900 s, tasks = isoform-question-gene-level-decline (shortest de4 task, max 4.5k decode) + baseline-covariate-for-power
# (mixed outcome -> nonzero advantages, so the LoRA update is real; its 4 smoke sessions finished in 2.2-3.8 min).
source "${HM_EXAMPLE_DIR}/configs/q27-de4-colo1n-smoke96k.env"
RUN_NAME=q27-de4-colo1n-smoke96k-r2
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/q27-de4-smoke2-short.txt
HM_AGENT_TIMEOUT=900
