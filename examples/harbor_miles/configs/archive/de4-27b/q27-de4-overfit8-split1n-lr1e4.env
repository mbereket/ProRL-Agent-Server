# QWEN27B 1-node SPLIT 27B de4 overfit at LR 1e-4 (coordinator 07:09, plan (A)): the LR hedge ("3e-5 too slow for 27B"; DIAG's 2n main
# run is at 3e-5) AND the MEASURED 1-node split step time. Compare with plan (B) = the same arm colocated on aws-iad
# (q27-de4-overfit8-colo1n.env) -> clean split-vs-colocated 1-node comparison; DIAG's 2n 4+12 at 3e-5 is the main overfit.
# Same work as DIAG: the 8 overfit tasks x 8/step, 96k, NO_MTP, merged serving, LoRA r32/a64, GRPO, ZV groups dropped, overlong = 0.
# Trainer: 4 GPUs TP4/CP1, 98304 tok/GPU + --log-probs-chunk-size 1024 + PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# (STACK: REAL 96k fits at full speed, 7.45k tok/s, 77.2 GB; without both it OOMs or runs 45% slower). The allocator setting goes in via
# Miles' --train-env-vars (set in the trainer workers' Ray runtime env at process start, i.e. before CUDA init = same effect as STACK's
# export before `ray start`), so the SGLang engine does not inherit it.
# Stragglers: cut one with an empty file RUN_DIR/cancel/<instance_id> (Path B 1fdfa6d6; the trial returns Flushed).
# Rollout: ONE TP4 engine (MEMF .85, 1.81M KV), 32 in flight (de4 knee <= ~35 per TP4 engine, MEASURED), fully async, staleness <= 2.
source "${HM_EXAMPLE_DIR}/configs/de4-codex-27b-lora-1n.env"
RUN_NAME=q27-de4-overfit8-split1n-lr1e4
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/q27-de4-overfit8.txt
LR=1e-4
LAYOUT=disagg
ASYNC=1
TRAIN_GPUS=4
TP=4
CP=1
MTPG=98304
ENGINE_TP=4
MEMF=0.85
ENGINE_KV_TOKENS=1814546
MAX_SEQ_LEN=98304
HARBOR_MAX_SEQ_LEN=98304
RBS=8
NS=8
MAX_STALENESS=2
NUM_ROLLOUT=40
DROP_ZERO_STD=1
SAVE_INTERVAL=1
LOGPROB_CHUNK=1024
EXTRA='--train-env-vars {"PYTORCH_CUDA_ALLOC_CONF":"expandable_segments:True"}'
ASYNC_CONCURRENCY=32
HM_SANDBOXES_PER_NODE=32
HM_SANDBOX_RESERVE_CPUS=16
HM_CHAIN_MAX=4
