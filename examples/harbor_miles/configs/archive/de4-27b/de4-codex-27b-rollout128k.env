# 27B de4 BASE PASS, launcher reference config (ROLLOUT_ONLY): Qwen3.8-27B base policy on eval-v2 de4-v1-k1 NORMAL
# (97 tasks, staged by the STAGING worker at <user root>/miles/shared/tasks/de4-v1-k1-normal), codex, NS attempts per task,
# 128k cap so session lengths are not truncated at 64k/96k. No trainer: all 8 GPUs of a node serve as 2 TP4 engines.
# Outputs: RUN_DIR/trials-<job>.jsonl (reward, exit status, wall per trial), the perf 0 metrics line (TITO mismatch rates on
# real de4 codex sessions, harbor/*), dumps RUN_DIR/dumps/rollout_0.pt + traj_0.jsonl (per-session token ids -> context and
# decode lengths, overflow at 64k/96k; trainer-replay traces), node-<job>-<host>.csv (sandbox CPU/memory density).
# Split over jobs: DE4_HALF=A|B (49/48 tasks) -> RUN_NAME suffix + task list. Full set in one job: DE4_HALF=all.
# Submit: --nodes 1 --hours 4 [--env DE4_HALF=B]. Leave HM_CHAIN_MAX unset (a rollout-only job just ends).
RUN_NAME=de4-codex-27b-rollout128k-${DE4_HALF:-A}
HARBOR_TASKS_DIR=${HM_USER_ROOT}/miles/shared/tasks/de4-v1-k1-normal/harbor
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/de4-v1-k1-half${DE4_HALF:-A}.txt
if [ "${DE4_HALF:-A}" = all ]; then TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/de4-v1-k1-normal-tasks.txt; fi
HARNESS=codex
HF_CKPT=${HM_USER_ROOT}/miles/models/Qwen3.8-27B
MODEL_TYPE=qwen3.8-27B
TITO_MODEL=qwen38small
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder
AGENT_MODEL_NAME=qwen38-27b
# Same patch stack as the training runs (merged serving); the LoRA itself is never used (base weights served).
ARM=lora
LORA_RANK=32
LORA_ALPHA=64
LORA_SERVE=merged
ROLLOUT_ONLY=1
# (TP/CP/MTPG: the actor is never built under ROLLOUT_ONLY; kept = the training layout, as in DIAG's validated hel 1527025.)
TP=4
CP=1
MTPG=65536
ENGINE_TP=4
ENGINE_KV_TOKENS=1814546
MEMF=0.85
# One rollout = every task of the list x NS attempts (RBS = task count, so no task repeats within the pass).
RBS=$(grep -c . "${TASK_IDS_FILE}")
NS=4
NUM_ROLLOUT=1
MAX_SEQ_LEN=131072
HARBOR_MAX_SEQ_LEN=131072
SAVE_INTERVAL=1000
HM_OVERLONG_REWARD=zero
MILES_RESPONSES_DEFAULT_MAX_TOKENS=0
# In flight = sandbox slots: 24 per TP4 engine (TP4 @ mem 0.85 = 1.81M KV tokens; 24 x ~40k live context ~ 55%; the 128k
# tail fits). Raise toward the KV knee once de4 context lengths are known.
HM_SANDBOXES_PER_NODE=48
# de4 task.toml: agent timeout 3600 s, verifier 600 s, 4 CPU / 8 GB per sandbox.
HM_AGENT_TIMEOUT=3600
HM_REAPER_EXEMPT_MINS=90
HM_AGENT_TOOLS=codex
# 91/97 de4 task.toml template NVINF_API_KEY into [verifier.env]; fail fast (name only) if the cluster ~/.secrets lacks it.
HM_REQUIRE_ENV=NVINF_API_KEY
# Data-analysis tasks: cap BLAS/OpenMP threads per agent process (48 sandboxes share the node's CPUs).
AGENT_ENV='{"OMP_NUM_THREADS":"4","OPENBLAS_NUM_THREADS":"4","MKL_NUM_THREADS":"4","RCPP_PARALLEL_NUM_THREADS":"4"}'
