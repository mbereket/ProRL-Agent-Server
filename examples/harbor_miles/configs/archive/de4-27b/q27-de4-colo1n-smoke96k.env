# QWEN27B colocated 1-node SMOKE at 96k (coordinator 06:50): does a colocated 27B de4 step run on Path B (sleep/wake, merged weight sync,
# memory peak) and how long are rollout vs train vs swap? 2 de4 tasks (one short: baseline-covariate-for-power ~41k ctx; one long:
# circadian-collection-confounder ~68k, exercises >64k) x 4 attempts, no zero-variance filtering, 2 rollouts (rollout 1 starts only after
# train 0 + offload/onload + merged sync -> proves the swap). Layout: all 8 GPUs time-share: trainer TP4 x CP2 headwise, 49152 tok/GPU
# (= 96k per sample; TP4xDP2 keeps the 4-GPU per-replica footprint -> OOM on REAL 96k, STACK), 2 SGLang TP4 engines (merged serving,
# MEMF 0.75, --lora-base-cpu-backup added by the driver for colocate). Base = Path B de4-codex-27b-lora-1n.env (11cf655a, NaN fix in).
source "${HM_EXAMPLE_DIR}/configs/de4-codex-27b-lora-1n.env"
RUN_NAME=q27-de4-colo1n-smoke96k
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/q27-de4-smoke2.txt
LAYOUT=colocate
ASYNC=0
TRAIN_GPUS=8
TP=4
CP=2
LINEAR_CP_MODE=headwise
MTPG=49152
ENGINE_TP=4
MEMF=0.75
ENGINE_KV_TOKENS=1500000
MAX_SEQ_LEN=98304
HARBOR_MAX_SEQ_LEN=98304
RBS=2
NS=4
NUM_ROLLOUT=2
DROP_ZERO_STD=0
SAVE_INTERVAL=1
HM_SANDBOXES_PER_NODE=8
HM_CHAIN_MAX=0
unset ASYNC_CONCURRENCY MAX_STALENESS
