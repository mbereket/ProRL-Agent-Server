# QWEN27B aws-iad 1-node COLOCATED REPLICATE of DIAG's 2-node 27B de4 overfit (diag-de4-27b-overfit8-2n-t8.env, miles-diag e840068e;
# dfw 19611218). Same work: the 8 DIAG tasks x 8 attempts/step, 96k cap, LoRA r32/a64 merged serving, NO_MTP, GRPO,
# zero-variance groups dropped, overlong = 0, same trainer (8 GPUs TP4 x CP2 headwise, 49152 tok/GPU), NUM_ROLLOUT 40 (LR is constant).
# Differences = LR (below) + layout: ONE node, trainer + 2 TP4 engines time-share the 8 GPUs (sleep/wake, MEMF 0.75, LoRA base CPU backup), which
# forces the SYNC loop (staleness 0; DIAG's 2n is async with staleness <= 2). Purpose: MEASURED 1n vs 2n step time / rollout-train split
# and a higher-LR learning arm: LR 1e-4 (coordinator 07:01) hedges "3e-5 too slow for 27B" (DIAG 2n at 3e-5 expects signal only after
# ~4.5-6.5 h). Watch the 9B failure mode at 1e-4 (length collapse / reward drop): stop if mean response tokens fall >20% with no reward gain.
# Validated by the colocated 96k smoke (configs/q27-de4-colo1n-smoke96k.env, aws-iad 7598908: swap ~25-50 s, train peak ~72 GB sampled).
# Stragglers: cut one with an empty file RUN_DIR/cancel/<instance_id> (Path B 1fdfa6d6).
source "${HM_EXAMPLE_DIR}/configs/de4-codex-27b-lora-1n.env"
RUN_NAME=q27-de4-overfit8-colo1n-lr1e4
LR=1e-4
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/q27-de4-overfit8.txt
LAYOUT=colocate
ASYNC=0
TRAIN_GPUS=8
TP=4
CP=2
LINEAR_CP_MODE=headwise
MTPG=49152
ENGINE_TP=4
MEMF=0.75
ENGINE_KV_TOKENS=1500000
MAX_SEQ_LEN=98304
HARBOR_MAX_SEQ_LEN=98304
RBS=8
NS=8
NUM_ROLLOUT=40
DROP_ZERO_STD=1
SAVE_INTERVAL=1
# Sync: one step's 64 sessions run together (32 per TP4 engine; de4 knee ~30 running at 1.5M KV, short sessions finish first).
# Sandboxes are not CPU-limited per sandbox (tool share ~5%); 16 CPUs reserved for the trainer/Ray.
HM_SANDBOXES_PER_NODE=64
HM_SANDBOX_RESERVE_CPUS=16
HM_CHAIN_MAX=0
unset ASYNC_CONCURRENCY MAX_STALENESS
