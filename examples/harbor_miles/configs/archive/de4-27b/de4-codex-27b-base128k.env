# QWEN27B layout/config study, step 3: Qwen3.8-27B BASE PASS on de4 (eval-v2 de4-v1-k1, 97 tasks) x 4 attempts, rollout-only (eval at
# step 0, then the job is cancelled), 128k cap so session lengths are not truncated (overflow at 64k/96k/128k is computed from the
# natural lengths). Outputs: per-task base rates, per-session decode/total tokens, turns, wall, tool-time share, overflow.
# Split into 2 one-node jobs (TASK_IDS_FILE = half A / half B) so the 388 sessions finish in ~1 h each.
# Layout (rollout-only): idle trainer 2 GPUs TP2 (Miles needs an actor) + 3 SGLang engines TP2 (merged serving = plain engines),
# 20 sessions per engine (60 sandboxes). Recipe settings otherwise (codex, Qwen3.8 TITO qwen38small, overlong = 0).
# de4 staged by the Path B staging worker (path-a/STATUS.md 05:36): shared tasks dir + de-v2 SIF in miles/shared/harbor_sif_images (no pulls);
# verifiers deterministic, but 91/97 task.toml template NVINF_API_KEY -> HM_REQUIRE_ENV fails fast if ~/.secrets lacks it.
RUN_NAME=de4-codex-27b-base128k-${DE4_HALF:-A}
HARBOR_TASKS_DIR=${HM_USER_ROOT}/miles/shared/tasks/de4-v1-k1-normal/harbor
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/de4-v1-k1-half${DE4_HALF:-A}.txt
HARNESS=codex
HF_CKPT=${HM_USER_ROOT}/miles/models/Qwen3.8-27B
MODEL_TYPE=qwen3.8-27B
TITO_MODEL=qwen38small
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder
AGENT_MODEL_NAME=qwen38-27b
ARM=lora
LORA_RANK=32
LORA_ALPHA=64
LORA_SERVE=merged
LR=3e-5
LAYOUT=disagg
TRAIN_GPUS=2
TP=2
CP=1
MTPG=131072
ENGINE_TP=2
MEMF=0.85
ASYNC=1
RBS=8
NS=8
MAX_STALENESS=2
NUM_ROLLOUT=1
MAX_SEQ_LEN=131072
HARBOR_MAX_SEQ_LEN=131072
DROP_ZERO_STD=1
HM_OVERLONG_REWARD=zero
EVAL_INTERVAL=5
EVAL_N=4
EVAL_BEFORE_TRAIN=1
EVAL_ONLY=1
EVAL_NAME=de4
HM_AGENT_TIMEOUT=3600
HM_REAPER_EXEMPT_MINS=60
HM_AGENT_TOOLS=codex
HM_REQUIRE_ENV=NVINF_API_KEY
MILES_RESPONSES_DEFAULT_MAX_TOKENS=0
# 20 sessions per TP2 engine (734k KV): de4 context lengths unknown -> stay under the knee
ASYNC_CONCURRENCY=60
HM_SANDBOXES_PER_NODE=60
HM_CHAIN_MAX=0
# Dump the eval samples (full token ids, loss masks) -> per-session final context / decode tokens for overflow@64k/96k and success vs
# length, and REAL 27B de4 traces for STACK's trainer replay. (Config is sourced before RUN_DIR exists -> spell the path out.)
EXTRA="--save-debug-rollout-data ${HM_ROOT}/runs/${RUN_NAME}/dumps/{rollout_id}.pt"
