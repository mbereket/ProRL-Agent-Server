# 2-BATCH-POINT VALIDATION, batch point 2 (PRIORITIES "batch scaling"; coordinator 07:35): B=128 on the FIXED 2-node layout of
# batch point 1 = DIAG r3 (miles-diag 7f76aa95 configs/diag-de4-27b-overfit8-2n-r3.env: B=64, 78 in flight). VERBATIM copy of r3
# (4-GPU TP4 trainer at 96k, logprob chunk 1024, PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True in the job env as in r3, so the
# engines see it too; 3 TP4 engines; NO_MTP; merged serving; CPU reserve 16; the same 8 de4 tasks; LR 3e-5), changing only:
#  - B = RBS 16 x NS 8 = 128: the same 8 tasks, 16 attempts each per step; groups stay 8 attempts, so zero-variance drop
#    statistics match point 1 (the fully-async producer cycles the 8 prompts);
#  - in flight 105 = 35 per TP4 engine (QWEN27B's measured de4 knee), 53 sandboxes per node;
#  - own RUN_NAME, eval off, NUM_ROLLOUT 4 = step 0 + 3 warm steps, after which the run ends by itself (chain 2 covers the
#    2 h batch_short limit).
RUN_NAME=de4-codex-27b-bs128-2n-r1
HARBOR_TASKS_DIR=${HM_USER_ROOT}/miles/shared/tasks/de4-v1-k1-normal/harbor
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/de4-diag-overfit8.txt
HARNESS=codex
HF_CKPT=${HM_USER_ROOT}/miles/models/Qwen3.8-27B
MODEL_TYPE=qwen3.8-27B
TITO_MODEL=qwen38small
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder
AGENT_MODEL_NAME=qwen38-27b
ARM=lora
LORA_RANK=32
LORA_ALPHA=64
LORA_SERVE=merged
NO_MTP=1
LR=3e-5
LAYOUT=disagg
TRAIN_GPUS=4
TP=4
CP=1
MTPG=98304
ENGINE_TP=4
ENGINE_KV_TOKENS=1814546
MEMF=0.85
ASYNC=1
RBS=16
NS=8
MAX_STALENESS=2
NUM_ROLLOUT=4
MAX_SEQ_LEN=98304
HARBOR_MAX_SEQ_LEN=98304
SAVE_INTERVAL=1
DROP_ZERO_STD=1
HM_OVERLONG_REWARD=zero
MILES_RESPONSES_DEFAULT_MAX_TOKENS=0
ASYNC_CONCURRENCY=105
HM_SANDBOXES_PER_NODE=53
HM_AGENT_TIMEOUT=3600
HM_REAPER_EXEMPT_MINS=90
HM_AGENT_TOOLS=codex
HM_REQUIRE_ENV=NVINF_API_KEY
AGENT_ENV='{"OMP_NUM_THREADS":"4","OPENBLAS_NUM_THREADS":"4","MKL_NUM_THREADS":"4","RCPP_PARALLEL_NUM_THREADS":"4"}'
HM_CHAIN_MAX=2
HM_SANDBOX_RESERVE_CPUS=16
LOGPROB_CHUNK=1024
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
