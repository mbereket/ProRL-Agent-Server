# 27B LoRA RL on de4, 1 node COLOCATED (QWEN27B frontier: best 1-node 27B layout, modeled ~14 min/step merged vs ~20 min for
# the 4+4 split, whose trainer idles ~70%). All 8 GPUs time-share: trainer TP4 x DP2 (64k tok/GPU), offloaded during rollout;
# 2 SGLang TP4 engines (merged serving; STACK §10 validated colocated merged on 9B). Colocate forces the SYNC loop: each
# step's 8 x 8 sessions run together, then one train step (long-session tail = idle engines).
# NOT YET VALIDATED on Path B (P1): check the args (--colocate, --actor-num-gpus-per-node 8), sleep/wake memory, engine KV
# at MEMF 0.75, step time vs the split layout. Everything else = de4-codex-27b-lora-1n.env.
source "${HM_EXAMPLE_DIR}/configs/de4-codex-27b-lora-1n.env"
RUN_NAME=de4-codex-27b-lora-colo1n-r1
LAYOUT=colocate
ASYNC=0
TRAIN_GPUS=8
TP=4
CP=1
MTPG=65536
ENGINE_TP=4
MEMF=0.75
ENGINE_KV_TOKENS=1500000
# Sync: one step's 64 sessions in flight together (32 per TP4 engine).
HM_SANDBOXES_PER_NODE=64
unset ASYNC_CONCURRENCY MAX_STALENESS
