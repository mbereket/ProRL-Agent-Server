# 27B LoRA RL on de4, 1 NODE (Path B recipe; PRIORITIES goal (1)). Qwen3.8-27B, eval-v2 de4-v1-k1 NORMAL (97 tasks, staged
# at <user root>/miles/shared/tasks/de4-v1-k1-normal; hel first, dfw once its SIF lands), codex, TITO qwen38small, merged
# serving, LoRA r32/a64, LR 3e-5, overlong = reward 0 (trained), GRPO + per-trajectory loss, fully async (staleness <= 2),
# zero-variance groups dropped, NO_MTP (STACK patches/no-mtp), cluster-side chaining, save every step.
# Layout: trainer 4 GPUs TP4/CP1/65536 tok/GPU + ONE SGLang TP4 engine (1.81M KV tokens @ mem 0.85, measured dfw 19608789).
# PROVISIONAL until QWEN27B's de4 base pass fixes them ("DE4 27B CONFIG" in qwen27b/STATUS.md): MAX_SEQ_LEN (64k here; 96k/128k
# need a different trainer layout, STACK §13), in-flight cap, batch. No inline eval (97 x 2 sessions would stall training
# for hours on one engine): evaluate checkpoints in separate jobs (ckpt/iter_N/adapter).
RUN_NAME=de4-codex-27b-lora-1n-r1
HARBOR_TASKS_DIR=${HM_USER_ROOT}/miles/shared/tasks/de4-v1-k1-normal/harbor
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/de4-v1-k1-normal-tasks.txt
HARNESS=codex
HF_CKPT=${HM_USER_ROOT}/miles/models/Qwen3.8-27B
MODEL_TYPE=qwen3.8-27B
TITO_MODEL=qwen38small
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder
AGENT_MODEL_NAME=qwen38-27b
ARM=lora
LORA_RANK=32
LORA_ALPHA=64
LORA_SERVE=merged
NO_MTP=1
LR=3e-5
LAYOUT=disagg
TRAIN_GPUS=4
TP=4
CP=1
MTPG=65536
ENGINE_TP=4
ENGINE_KV_TOKENS=1814546
MEMF=0.85
ASYNC=1
RBS=8
NS=8
MAX_STALENESS=2
NUM_ROLLOUT=200
MAX_SEQ_LEN=65536
HARBOR_MAX_SEQ_LEN=65536
SAVE_INTERVAL=1
DROP_ZERO_STD=1
HM_OVERLONG_REWARD=zero
MILES_RESPONSES_DEFAULT_MAX_TOKENS=0
# In flight sized to the single TP4 engine (~26 sessions at ~50k context); revisit with de4 context lengths.
ASYNC_CONCURRENCY=26
HM_SANDBOXES_PER_NODE=26
# de4 task.toml: agent timeout 3600 s, verifier 600 s, 4 CPU / 8 GB per sandbox.
HM_AGENT_TIMEOUT=3600
HM_REAPER_EXEMPT_MINS=90
HM_AGENT_TOOLS=codex
HM_REQUIRE_ENV=NVINF_API_KEY
AGENT_ENV='{"OMP_NUM_THREADS":"4","OPENBLAS_NUM_THREADS":"4","MKL_NUM_THREADS":"4","RCPP_PARALLEL_NUM_THREADS":"4"}'
HM_CHAIN_MAX=8
