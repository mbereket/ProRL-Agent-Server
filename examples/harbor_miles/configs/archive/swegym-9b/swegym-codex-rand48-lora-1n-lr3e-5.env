# LR sweep arm (H2H_SPEC v2): identical to swegym-codex-rand48-lora-1n.env except LR=3e-5 and RUN_NAME.
# P0 head-to-head, 1 node: Miles LoRA GRPO (fully async) on SWE-Gym Lite rand48-s0 (Path A's seeded random 48
# tasks, copied verbatim: swegym-rand48-s0.txt/.README) with codex 0.125.0 through the Miles session /v1/responses
# adapter. Matched to Path A's swegym-rand48-lora-1node.yaml: trainer 4 GPUs TP4 no CP (65536 tok/GPU, 64k cap),
# 2 SGLang engines TP2 (triton LoRA), 48 sandboxes, 8 tasks x 8 attempts per step, staleness <= 2, LoRA r32/a64,
# lr 1e-5, overlong trained with reward 0, zero-variance groups dropped, eval on all 48 x 2 every 5 steps (unfiltered).
RUN_NAME=swegym-codex-rand48-lora-1n-lr3e-5-r2
HARBOR_TASKS_DIR=${HM_SHARED}/tasks/swegym-lite-v3/harbor
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/swegym-rand48-s0.txt
HARNESS=codex
HF_CKPT=${HM_SHARED}/hf_home/hub/models--Qwen--Qwen3.5-9B/snapshots/c202236235762e1c871ad0ccb60c8ee5ba337b9a
ARM=lora
LORA_RANK=32
LORA_ALPHA=64
LR=3e-5
LAYOUT=disagg
TRAIN_GPUS=4
TP=4
CP=1
MTPG=65536
ENGINE_TP=2
MEMF=0.8
ASYNC=1
RBS=8
NS=8
MAX_STALENESS=2
NUM_ROLLOUT=200
MAX_SEQ_LEN=65536
MAXRESP=8192
SAVE_INTERVAL=2
DROP_ZERO_STD=1
HM_OVERLONG_REWARD=zero
EVAL_INTERVAL=5
EVAL_N=2
EVAL_NAME=train48
HM_SANDBOXES_PER_NODE=48
HM_AGENT_TIMEOUT=1800
HM_REAPER_EXEMPT_MINS=60
HARBOR_MAX_SEQ_LEN=65536
HM_AGENT_TOOLS=codex
# Per-call max_new_tokens: pass through what codex sends (max_output_tokens), else none -> engine default
# (remaining context), exactly like Path A's gateway (H2H_SPEC: same per-call cap on both paths).
MILES_RESPONSES_DEFAULT_MAX_TOKENS=0
