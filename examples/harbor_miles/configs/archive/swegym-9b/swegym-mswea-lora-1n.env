# SWE-Gym Lite, 1 node: Miles LoRA GRPO (fully async) with mini-swe-agent in Harbor/Apptainer sandboxes.
# Preliminary task pool = the 93 swegym-lite-v3 tasks whose images are staged on dfw (Path A's band
# replaces it when published). Layout: 4 trainer GPUs (TP2 x CP2, 64k trajectories) + 2 SGLang engines
# TP2 (triton LoRA); session cap from engine KV capacity; sandboxes on the node.
RUN_NAME=swegym-mswea-lora-1n
HARBOR_TASKS_DIR=${HM_SHARED}/tasks/swegym-lite-v3/harbor
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/swegym-dfw-staged93.txt
HARNESS=mini-swe-agent
HF_CKPT=${HM_SHARED}/hf_home/hub/models--Qwen--Qwen3.5-9B/snapshots/c202236235762e1c871ad0ccb60c8ee5ba337b9a
ARM=lora
LORA_RANK=32
LORA_ALPHA=32
LR=1e-5
LAYOUT=disagg
TRAIN_GPUS=4
TP=2
CP=2
MTPG=32768
ENGINE_TP=2
MEMF=0.8
ASYNC=1
RBS=4
NS=8
MAX_STALENESS=2
NUM_ROLLOUT=500
MAX_SEQ_LEN=65536
MAXRESP=8192
SAVE_INTERVAL=2
DROP_ZERO_STD=1
HM_SANDBOXES_PER_NODE=32
HM_AGENT_TIMEOUT=1800
HM_REAPER_EXEMPT_MINS=60
AGENT_MAX_INPUT_TOKENS=57344
AGENT_MAX_OUTPUT_TOKENS=8192
HARBOR_MAX_SEQ_LEN=65536
