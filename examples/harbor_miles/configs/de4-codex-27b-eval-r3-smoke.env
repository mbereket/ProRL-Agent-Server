# DECOUPLED EVAL smoke (coordinator 08:00): evaluate the latest saved adapter of DIAG's r3 run (diag-de4-27b-overfit8-r3) on its 8
# de4 tasks x 2, with the launcher's EVAL_FROM_RUN mode:
#  - a trainer with r3's layout (4 GPUs TP4; NO_MTP as in r3) loads the per-rank adapter shards;
#  - the startup weight sync serves W + (alpha/r)BA merged on one TP4 engine, as in training;
#  - the eval runs before any training, and the job stops when `eval 0:` lands.
# Results: RUN_DIR/trials-<job>.jsonl (split=eval@N), RUN_DIR/eval@N-<job>.json, RUN_DIR/eval_summary.tsv.
# The checkpoint must be on THIS cluster's lustre (r3 is on dfw). Elsewhere, copy <run>/ckpt/iter_N/adapter/{adapter_megatron_rank*,
# training_state_rank*}.pt and point EVAL_FROM_RUN at the copy's run dir (absolute path).
# Smoke sizing: 16 sessions, agent timeout 900 s (smoke rule). A real eval keeps the task timeout (3600 s).
source "${HM_EXAMPLE_DIR}/configs/de4-codex-27b-lora-1n.env"
RUN_NAME=de4-eval-r3-smoke
EVAL_FROM_RUN=${EVAL_FROM_RUN:-diag-de4-27b-overfit8-r3}
EVAL_STEP=${EVAL_STEP:-latest}
EVAL_N=${EVAL_N:-2}
EVAL_NAME=de4overfit8
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/de4-diag-overfit8.txt
MAX_SEQ_LEN=98304
HARBOR_MAX_SEQ_LEN=98304
NO_MTP=1
HM_AGENT_TIMEOUT=900
HM_SANDBOX_RESERVE_CPUS=16
HM_CHAIN_MAX=0
