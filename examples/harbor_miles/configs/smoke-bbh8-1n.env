# Smoke: Miles LoRA GRPO on the 8 BBH-MCP overfit tasks, 1 node (4 trainer GPUs + 4 SGLang engines),
# sandboxes on the same node. Checks the whole loop: TITO sessions, Harbor trials, rewards, LoRA sync.
RUN_NAME=smoke2-bbh8-1n
HARBOR_TASKS_DIR=${HM_SHARED}/tasks/bbh-mcp-train-v1/harbor
AGENT_IMPORT_PATH=harbor_miles_agents.opencode_agents:BbhOpenCode
HF_CKPT=${HM_SHARED}/hf_home/hub/models--Qwen--Qwen3.5-9B/snapshots/c202236235762e1c871ad0ccb60c8ee5ba337b9a
ARM=lora
LAYOUT=disagg
TRAIN_GPUS=4
TP=2
CP=1
MTPG=32768
ENGINE_TP=1
MEMF=0.8
RBS=4
NS=4
NUM_ROLLOUT=2
MAX_SEQ_LEN=65536
MAXRESP=8192
SAVE_INTERVAL=100
HM_SANDBOXES_PER_NODE=24
HM_AGENT_TIMEOUT=1800
HM_REAPER_EXEMPT_MINS=60
