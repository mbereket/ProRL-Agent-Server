# D5: Qwen3.8-27B on Path B, 1 node, H2H_SPEC v3 (rand48-s0, codex 0.125.0, 64k, 8 x 8, staleness <= 2, LoRA r32/a64,
# lr 3e-5 (v3: sweep midpoint), zero-variance drop, overlong = reward 0 trained, eval 48 x 2 every 5 steps). 27B changes only the model and
# the layout measured by the qwen27b agent: trainer 4 GPUs TP4 no CP (65536 tok/GPU, 79 GB peak on real traces) and ONE
# SGLang engine TP4 (mem 0.85, ~1.9M KV tokens, 144 running) for 48 sessions.
RUN_NAME=swegym-codex-27b-rand48-lora-1n
HARBOR_TASKS_DIR=${HM_SHARED}/tasks/swegym-lite-v3/harbor
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/swegym-rand48-s0.txt
HARNESS=codex
HF_CKPT=${HM_USER_ROOT}/miles/models/Qwen3.8-27B
MODEL_TYPE=qwen3.8-27B
TITO_MODEL=qwen38small
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder
AGENT_MODEL_NAME=qwen38-27b
ARM=lora
LORA_RANK=32
LORA_ALPHA=64
LR=3e-5
LAYOUT=disagg
TRAIN_GPUS=4
TP=4
CP=1
MTPG=65536
ENGINE_TP=4
ENGINE_KV_TOKENS=1895938
MEMF=0.85
ASYNC=1
RBS=8
NS=8
MAX_STALENESS=2
NUM_ROLLOUT=200
MAX_SEQ_LEN=65536
SAVE_INTERVAL=2
DROP_ZERO_STD=1
HM_OVERLONG_REWARD=zero
EVAL_INTERVAL=5
EVAL_N=2
EVAL_NAME=train48
HM_AGENT_TIMEOUT=1800
HM_REAPER_EXEMPT_MINS=60
HARBOR_MAX_SEQ_LEN=65536
HM_AGENT_TOOLS=codex
MILES_RESPONSES_DEFAULT_MAX_TOKENS=0
# In-flight cap sized to the single TP4 engine (coordinator 23:50): ~24-28 sessions at ~50k context in 1.9M KV tokens.
ASYNC_CONCURRENCY=26
HM_SANDBOXES_PER_NODE=26
