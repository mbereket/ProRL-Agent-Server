# Qwen3.8-27B on Path B: SWE-Gym, codex, Miles LoRA GRPO (fully async), 1 node.
# Layout from the qwen27b agent's measurements: trainer 4 GPUs TP4 (Megatron TP<=4 for 27B, 32k train cap)
# + 2 SGLang engines TP2 (733,851 KV tokens each); trajectory cap 32k to match the train cap.
RUN_NAME=swegym-codex-27b-lora-1n
HARBOR_TASKS_DIR=${HM_SHARED}/tasks/swegym-lite-v3/harbor
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/swegym-dfw-staged93.txt
HARNESS=codex
HF_CKPT=${HM_USER_ROOT}/miles/models/Qwen3.8-27B
MODEL_TYPE=qwen3.8-27B
TITO_MODEL=qwen38small
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder
AGENT_MODEL_NAME=qwen38-27b
ARM=lora
LORA_RANK=32
LORA_ALPHA=32
LR=1e-5
LAYOUT=disagg
TRAIN_GPUS=4
TP=4
CP=1
MTPG=32768
ENGINE_TP=2
ENGINE_KV_TOKENS=733851
MEMF=0.8
ASYNC=1
RBS=4
NS=8
MAX_STALENESS=2
NUM_ROLLOUT=500
MAX_SEQ_LEN=32768
MAXRESP=8192
SAVE_INTERVAL=2
DROP_ZERO_STD=1
HM_SANDBOXES_PER_NODE=32
HM_AGENT_TIMEOUT=1800
HM_REAPER_EXEMPT_MINS=60
HARBOR_MAX_SEQ_LEN=32768
HM_AGENT_TOOLS=codex
