# DIAG 27B de4 OVERFIT r3 (running: dfw 19612545, miles-diag 7f76aa95 configs/diag-de4-27b-overfit8-2n-r3.env), re-expressed.
# Dry-render equivalent to the original (tools/config_equiv.sh): only the run-dir path differs.
RUN_NAME=diag-de4-27b-overfit8-r3
LAYOUT_PRESET=27b-2n
DATASET=de4-v1-k1
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/tasks/de4-overfit8.txt
CAP=96k
LR=3e-5
INFLIGHT_PER_ENGINE=26                            # r3 ran 78 in flight (26/engine), below the 35 knee
HM_SANDBOXES_PER_NODE=40                          # r3 value (derived would be 39)
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True  # r3 exported it job-wide (engines too); the recipe gives it to the trainer only
