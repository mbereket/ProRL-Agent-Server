# Clean 27B de4 overfit (coordinator, 2026-10-01 ~10:25 PT; user request): 8 de4 tasks, ALL with intermediate base success
# (27B base pass, n=8 per task: 2-6 of 8 = .25-.75), short enough for 96k (<= 25% of base sessions above 96k; <= 1 of 8 hit
# 128k), none involved in the sandbox memory runaways (F63). 8 x 8 per step, 2 nodes (4-GPU TP4 trainer + 3 TP4 engines,
# 32 in flight/engine), 96k cap, recipe settings; W&B project miles-rl, run name = RUN_NAME. LR arm: 3e-5.
RUN_NAME=overfit-de4-lr3e-5
LAYOUT_PRESET=27b-2n
DATASET=de4-v1-k1
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/tasks/de4-overfit8-v2.txt
CAP=96k
LR=3e-5
NUM_ROLLOUT=40
WANDB_PROJECT=miles-rl
HM_REQUIRE_ENV="NVINF_API_KEY WANDB_API_KEY"
