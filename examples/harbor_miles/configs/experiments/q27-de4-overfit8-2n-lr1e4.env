# QWEN27B LR-1e-4 HEDGE (running: dfw 19612902, miles-qwen27b d48fac8a configs/q27-de4-overfit8-2n-lr1e4.env), re-expressed:
# = DIAG r3 except LR 1e-4 and the allocator setting going to the trainer only (the recipe default at 96k).
RUN_NAME=q27-de4-overfit8-2n-lr1e4
LAYOUT_PRESET=27b-2n
DATASET=de4-v1-k1
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/tasks/de4-overfit8.txt
CAP=96k
LR=1e-4
INFLIGHT_PER_ENGINE=26
HM_SANDBOXES_PER_NODE=40
