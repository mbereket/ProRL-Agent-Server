# DECOUPLED EVAL of saved LoRA adapters (driver EVAL_FROM_RUN mode; the job stops when `eval 0:` lands, nothing is written into
# the source run). Example: the latest adapter of DIAG's r3 (diag-de4-27b-overfit8-r3; a run name is looked up in
# <user root>/miles/runs, then the legacy miles/{path-b,qwen27b,shared/hm}/runs) on its 8 de4 tasks x 2. The trainer must have
# the SOURCE run's trainer GPUs (r3: 4, TP4) to load the per-rank shards: 27b-1n-split = 4-GPU TP4 trainer + 1 TP4 engine
# serving W + (a/r)BA merged, as in training. EVAL_WATCH_EVERY=K keeps evaluating each newer checkpoint (>= last + K).
# Results: RUN_DIR/trials-<job>.jsonl (split=eval@N), RUN_DIR/eval@N-<job>.json, RUN_DIR/eval_summary.tsv. Smoke sizing: 900 s.
RUN_NAME=de4-eval-r3-smoke
LAYOUT_PRESET=27b-1n-split
DATASET=de4-v1-k1
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/tasks/de4-overfit8.txt
CAP=96k
EVAL_FROM_RUN=${EVAL_FROM_RUN:-diag-de4-27b-overfit8-r3}   # submit.py --env EVAL_FROM_RUN=/abs/run/dir (or another run name) overrides
EVAL_STEP=${EVAL_STEP:-latest}
EVAL_N=${EVAL_N:-2}
EVAL_NAME=de4overfit8
HM_AGENT_TIMEOUT=900
