# 1-NODE VALIDATION SMOKE (same checks as de4-27b-smoke-2n.env minus the second node): 27b-1n-split at 96k, 2 short tasks x 4,
# 2 steps. Fits every 1-node pool (aws-iad interactive, dfw batch_short, hel interactive).
RUN_NAME=hm-smoke-27b-1n-96k
LAYOUT_PRESET=27b-1n-split
DATASET=de4-v1-k1
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/tasks/de4-smoke2-short.txt
CAP=96k
RBS=2
NS=4
NUM_ROLLOUT=2
ASYNC_CONCURRENCY=8
DROP_ZERO_STD=0
HM_AGENT_TIMEOUT=900
HM_CHAIN_MAX=0
