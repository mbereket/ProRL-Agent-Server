# DIAG 27B de4 OVERFIT r3b (coordinator 08:55): RESUME of r3 (same RUN_NAME/run dir/ckpt, same code miles-diag 7f76aa95) with the
# two dead tasks REMOVED: cellline-lineage-confounder (30/31 at base, always zero-variance) and circadian-collection-confounder
# (0/19). 6 tasks remain. Everything else identical (LR 3e-5, RBS 8, NS 8, filter on, 78 in flight, 96k, chunk 1024 + expandable).
# RESUME SAFETY: Miles' data source restores sample_offset/epoch_id (fully async asks 1 group at a time; an offset past the new
# 6-row dataset wraps to a new shuffled epoch, no crash). BUT train_driver only builds RUN_DIR/data/train.jsonl when it's absent, so
# the old 8-task file would be reused. The guarded mv below moves it aside ONLY if it still has 8 rows (never the new 6-row file).
RUN_NAME=diag-de4-27b-overfit8-r3
HARBOR_TASKS_DIR=${HM_USER_ROOT}/miles/shared/tasks/de4-v1-k1-normal/harbor
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/diag-de4-27b-overfit6.txt
HARNESS=codex
HF_CKPT=${HM_USER_ROOT}/miles/models/Qwen3.8-27B
MODEL_TYPE=qwen3.8-27B
TITO_MODEL=qwen38small
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder
AGENT_MODEL_NAME=qwen38-27b
ARM=lora
LORA_RANK=32
LORA_ALPHA=64
LORA_SERVE=merged
NO_MTP=1
LR=3e-5
LAYOUT=disagg
TRAIN_GPUS=4
TP=4
CP=1
MTPG=98304
ENGINE_TP=4
ENGINE_KV_TOKENS=1814546
MEMF=0.85
ASYNC=1
RBS=8
NS=8
MAX_STALENESS=2
NUM_ROLLOUT=40
MAX_SEQ_LEN=98304
HARBOR_MAX_SEQ_LEN=98304
SAVE_INTERVAL=1
DROP_ZERO_STD=1
HM_OVERLONG_REWARD=zero
MILES_RESPONSES_DEFAULT_MAX_TOKENS=0
ASYNC_CONCURRENCY=78
HM_SANDBOXES_PER_NODE=40
HM_AGENT_TIMEOUT=3600
HM_REAPER_EXEMPT_MINS=90
HM_AGENT_TOOLS=codex
HM_REQUIRE_ENV=NVINF_API_KEY
AGENT_ENV='{"OMP_NUM_THREADS":"4","OPENBLAS_NUM_THREADS":"4","MKL_NUM_THREADS":"4","RCPP_PARALLEL_NUM_THREADS":"4"}'
HM_CHAIN_MAX=8
HM_SANDBOX_RESERVE_CPUS=16
LOGPROB_CHUNK=1024
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
_hm_d="${HM_ROOT}/runs/${RUN_NAME}/data/train.jsonl"
{ [ -f "${_hm_d}" ] && [ "$(wc -l < "${_hm_d}" | tr -d " ")" = 8 ] && mv -n "${_hm_d}" "${_hm_d}.r3-8tasks" && echo "[diag-cfg] $(hostname -s) moved 8-task train.jsonl aside" >&2; } || true
echo "[diag-cfg] $(hostname -s) PYTORCH_CUDA_ALLOC_CONF=${PYTORCH_CUDA_ALLOC_CONF} LOGPROB_CHUNK=${LOGPROB_CHUNK} TASK_IDS_FILE=${TASK_IDS_FILE}" >&2
