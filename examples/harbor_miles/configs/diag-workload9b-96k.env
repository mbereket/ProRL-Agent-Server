# DIAG workload characterization (LAYOUT_STUDY step 1, 9B), cap 96k: ROLLOUT ONLY (--debug-rollout-only), base policy,
# recipe harness settings (codex 0.125.0, no codex window -> sessions end on the engine's context refusal = overlong),
# all 48 rand48 tasks x 2 attempts (2 sync rollouts x 24 tasks), all 8 GPUs as 4 TP2 engines (12 sessions/engine).
# Dumps: Miles rollout_data .pt per rollout (trainer-replay traces for STACK) + per-sample trajectory JSONL.
# Agent timeout 3600 s (vs recipe 1800) so long sessions at large caps aren't cut by time; the timeout rate is reported.
RUN_NAME=diag-workload9b-96k
HARBOR_TASKS_DIR=${HM_SHARED}/tasks/swegym-lite-v3/harbor
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/swegym-rand48-s0.txt
HARNESS=codex
HF_CKPT=${HM_SHARED}/hf_home/hub/models--Qwen--Qwen3.5-9B/snapshots/c202236235762e1c871ad0ccb60c8ee5ba337b9a
ARM=lora
LORA_RANK=32
LORA_ALPHA=64
LORA_SERVE=merged
LR=3e-5
LAYOUT=disagg
TRAIN_GPUS=4
TP=4
CP=1
MTPG=65536
ENGINE_TP=2
MEMF=0.8
ASYNC=0
RBS=24
NS=2
NUM_ROLLOUT=2
MAX_SEQ_LEN=98304
HARBOR_MAX_SEQ_LEN=98304
MAXRESP=8192
SAVE_INTERVAL=1000
DROP_ZERO_STD=0
HM_OVERLONG_REWARD=zero
HM_AGENT_TIMEOUT=3600
AGENT_TRIAL_TIMEOUT=4200
HM_REAPER_EXEMPT_MINS=90
HM_SANDBOXES_PER_NODE=64
HM_AGENT_TOOLS=codex
MILES_RESPONSES_DEFAULT_MAX_TOKENS=0
EXTRA="--debug-rollout-only --rollout-num-gpus 8 --save-debug-rollout-data ${HM_ROOT}/runs/diag-workload9b-96k/dumps/rollout_{rollout_id}.pt --save-debug-trajectory-data ${HM_ROOT}/runs/diag-workload9b-96k/dumps/traj_{rollout_id}.jsonl"
