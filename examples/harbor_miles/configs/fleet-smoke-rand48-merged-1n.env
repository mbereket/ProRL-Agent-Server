# FLEET readiness smoke for aws-iad / ord / draco: Path B's rand48 1-node shape (trainer 4 GPUs TP4 no CP 65536, 2 engines
# TP2, 8x8 per step, async staleness <= 2, r32/a64, lr 1e-5), 2 steps, merged LoRA serving, no eval. A100 (ord/draco):
# clusters.sh adds patches/a100; use HM_SANDBOXES_PER_NODE=32 there until the host-OOM at 48 is understood.
RUN_NAME=fleet-smoke-rand48-merged-${CLUSTER}
HARBOR_TASKS_DIR=${HM_SHARED}/tasks/swegym-lite-v3/harbor
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/swegym-rand48-s0.txt
HARNESS=codex
HF_CKPT=${HM_SHARED}/hf_home/hub/models--Qwen--Qwen3.5-9B/snapshots/c202236235762e1c871ad0ccb60c8ee5ba337b9a
ARM=lora
LORA_SERVE=merged
LORA_RANK=32
LORA_ALPHA=64
LR=1e-5
LAYOUT=disagg
TRAIN_GPUS=4
TP=4
CP=1
MTPG=65536
ENGINE_TP=2
MEMF=0.8
ASYNC=1
RBS=8
NS=8
MAX_STALENESS=2
NUM_ROLLOUT=2
MAX_SEQ_LEN=65536
MAXRESP=8192
SAVE_INTERVAL=1
DROP_ZERO_STD=1
HM_OVERLONG_REWARD=zero
HM_SANDBOXES_PER_NODE=48
HM_AGENT_TIMEOUT=1800
HARBOR_MAX_SEQ_LEN=65536
HM_AGENT_TOOLS=codex
MILES_RESPONSES_DEFAULT_MAX_TOKENS=0
