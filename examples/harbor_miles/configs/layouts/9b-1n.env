# 9B, 1 NODE, split (the D1/D2 SWE-Gym shape): trainer 4 GPUs TP4 / CP1 (D3: 5.0k tok/s/GPU on real 64k traces) + 2 TP2
# engines (64 in flight). Rollout-bound. Runs on every pool incl. aws-iad; A100 (ord/draco): HM_SANDBOXES_PER_NODE=32.
# 128k needs 8 trainer GPUs for 9B (TP8 or TP4 x CP2 headwise); nothing fits 128k on 4.
source "${HM_EXAMPLE_DIR}/configs/models/qwen3.5-9b.env"
NODES=1
LAYOUT=disagg
TRAIN_GPUS=4
TP=4
CP=1
MAX_CAP=65536
