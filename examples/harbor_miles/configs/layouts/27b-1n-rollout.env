# 27B ROLLOUT-ONLY (base pass / workload measurement; no trainer, Miles --debug-rollout-only): 1 node = 2 TP4 engines with the
# base weights, 35 sessions in flight each (sandbox slots = in-flight; the dispatcher queues the rest). Sync, unfiltered, no
# eval; dumps under RUN_DIR/dumps. The job ends after NUM_ROLLOUT rollouts (set HM_CHAIN_MAX=0, NUM_ROLLOUT=1).
# Use a high cap (128k+) so session lengths are not truncated. (The de4 base pass ran on TP2 engines: KV-bound, ~2 sessions/min.)
source "${HM_EXAMPLE_DIR}/configs/models/qwen3.8-27b.env"
NODES=1
ROLLOUT_ONLY=1
LAYOUT=disagg
TP=4
CP=1
CAP=128k
HM_CHAIN_MAX=0
NUM_ROLLOUT=1
SAVE_INTERVAL=1000
