# 27B, 1 NODE, COLOCATED: trainer (8 GPUs TP4 x CP2 headwise) and 2 TP4 engines time-share all 8 GPUs (sleep/wake between
# phases; merged sync). Forces the SYNC loop (staleness 0). Smoke PASSED at 96k (aws-iad 7598908: train peak 70.3 GiB, rollout
# 64.3 GiB, swap ~1 min/step); timing run aws-iad 7599199. CP2 is needed at 96k (TP4 x DP2 does not fit REAL 96k); at 64k an
# experiment may set CP=1 (TP4 x DP2, faster).
source "${HM_EXAMPLE_DIR}/configs/models/qwen3.8-27b.env"
NODES=1
LAYOUT=colocate
ASYNC=0
TRAIN_GPUS=8
TP=4
CP=2
MEMF=0.75                   # engines share the GPUs with the resident trainer
ENGINE_KV_TOKENS=1500000    # measured 1.47-1.48M per TP4 engine at MEMF 0.75 (aws-iad 7598908)
# MODEL: the de4 knee scaled by KV (38 running x 1.47M / 1.89M ~ 29.6) -> 28 per engine. The timing run used 32 (64 sessions).
INFLIGHT_PER_ENGINE=28
KNEE_INFLIGHT_PER_ENGINE=28
MAX_CAP=98304
# No expandable segments here: the validated colocated runs (smoke 7598908, timing 7599199) ran without them (train peak 70.3 GiB
# at 96k with logprob chunk 4096) and their interaction with the colocated sleep/wake memory saver is untested.
TRAIN_ALLOC_CONF=
