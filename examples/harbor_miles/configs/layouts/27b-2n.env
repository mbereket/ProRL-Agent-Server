# 27B, 2 NODES, split (the current main 27B layout; DIAG overfit r3, the LR hedge, batch points):
#   node 0: trainer 4 GPUs TP4 / CP1 + one TP4 engine; node 1: two TP4 engines -> 3 TP4 engines, sandboxes on both nodes.
# Caps: 64k fits comfortably (62 GB); 96k fits with logprob chunk 1024 + expandable segments (derived automatically from the cap:
# REAL traces 77.2 GB, 7.45k tok/s, STACK §13); 128k does NOT fit a 4-GPU trainer -> layouts/27b-2n-128k (or 27b-3n-128k).
# hel/dfw only (aws-iad is single-node: EFA, no cross-node NCCL). Submit with --nodes 2.
source "${HM_EXAMPLE_DIR}/configs/models/qwen3.8-27b.env"
NODES=2
LAYOUT=disagg
TRAIN_GPUS=4
TP=4
CP=1
MAX_CAP=98304
