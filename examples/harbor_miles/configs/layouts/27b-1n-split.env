# 27B, 1 NODE, split: trainer 4 GPUs TP4 / CP1 + ONE TP4 engine (35 in flight). Rollout-bound (MODEL ~19.5 min/step at 64k, B=64;
# timing run hel 1527509 at 96k). Fits every 1-node pool incl. aws-iad (9 h) and dfw batch_short.
# Caps: 64k comfortable; 96k with logprob chunk 1024 + expandable segments (derived); 128k does NOT fit 4 trainer GPUs.
source "${HM_EXAMPLE_DIR}/configs/models/qwen3.8-27b.env"
NODES=1
LAYOUT=disagg
TRAIN_GPUS=4
TP=4
CP=1
MAX_CAP=98304
