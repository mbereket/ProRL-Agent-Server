# 27B, 3 NODES, 8-GPU trainer (for caps up to 128k): node 0 = trainer 8 GPUs TP4 x CP2 headwise (as 27b-2n-128k); nodes 1-2 =
# four TP4 engines (140 in flight). Derived at 128k: 65536 tok/GPU, logprob chunk 4096, expandable_segments for the trainer
# (REAL 128k 68.3 GB, aws-iad 7598871). End to end UNTESTED. Rollout capacity 2x 27b-2n-128k for the same trainer: use it when
# the 2n-128k run is rollout-bound (long 128k sessions). 3 nodes exceed the hel/dfw interactive cap (2 per user): batch only.
source "${HM_EXAMPLE_DIR}/configs/models/qwen3.8-27b.env"
NODES=3
LAYOUT=disagg
TRAIN_GPUS=8
TP=4
CP=2
MAX_CAP=131072
