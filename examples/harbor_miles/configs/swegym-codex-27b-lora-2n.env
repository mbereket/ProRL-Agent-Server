# 27B 2-node split layout (qwen27b's best 2-node layout): 4 trainer GPUs (TP4, no CP, 65536 tok/GPU) on the first node
# + 3 SGLang TP4 engines (node 0 GPUs 4-7, node 1 GPUs 0-3 and 4-7), merged serving. In flight 78 = 3 x 26 (26 per TP4
# engine at ~50k context; TP4 merged engine: 1,814,546 KV tokens @ mem 0.85, measured dfw 19608789). Sandboxes: 40 per
# node on both nodes (dispatch is least-loaded across the nodes' agent servers). Everything else = the 1-node config.
# Submit with --nodes 2.
RUN_NAME=swegym-codex-27b-rand48-lora-2n-r1
HARBOR_TASKS_DIR=${HM_SHARED}/tasks/swegym-lite-v3/harbor
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/swegym-rand48-s0.txt
HARNESS=codex
HF_CKPT=${HM_USER_ROOT}/miles/models/Qwen3.8-27B
MODEL_TYPE=qwen3.8-27B
TITO_MODEL=qwen38small
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder
AGENT_MODEL_NAME=qwen38-27b
ARM=lora
LORA_RANK=32
LORA_ALPHA=64
LORA_SERVE=merged
LR=3e-5
LAYOUT=disagg
TRAIN_GPUS=4
TP=4
CP=1
MTPG=65536
ENGINE_TP=4
ENGINE_KV_TOKENS=1814546
MEMF=0.85
ASYNC=1
RBS=8
NS=8
MAX_STALENESS=2
NUM_ROLLOUT=200
MAX_SEQ_LEN=65536
SAVE_INTERVAL=1
DROP_ZERO_STD=1
HM_OVERLONG_REWARD=zero
EVAL_INTERVAL=10
EVAL_N=2
EVAL_NAME=train48
HM_AGENT_TIMEOUT=1800
HM_REAPER_EXEMPT_MINS=60
HARBOR_MAX_SEQ_LEN=65536
HM_AGENT_TOOLS=codex
MILES_RESPONSES_DEFAULT_MAX_TOKENS=0
ASYNC_CONCURRENCY=78
HM_SANDBOXES_PER_NODE=40
# Recipe settings (coordinator 05:2x): merged serving, codex without a window (launcher 9c1da531), eval every 10, save every
# step, cluster-side chaining. First chunk doubles as the Qwen3.8 TITO template smoke check (rollbacks / rejections /
# critical TITO mismatch / one trajectory per session).
HM_CHAIN_MAX=2
