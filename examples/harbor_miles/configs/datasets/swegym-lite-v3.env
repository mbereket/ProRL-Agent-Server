# SWE-Gym Lite (swegym-lite-v3 Harbor packages). hel/dfw: <user root>/prorl-harbor/tasks (HM_SHARED, read-only);
# aws-iad/ord/draco: <user root>/miles/shared/tasks (FLEET). Default task list = Path A's seeded random 48 (rand48-s0, D1/D2).
# Image SIFs: all 100 band tasks on dfw/hel/aws-iad/ord/draco (check before using other tasks: tools/stage_sifs.sh).
HARBOR_TASKS_DIR=${HM_SHARED}/tasks/swegym-lite-v3/harbor
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/tasks/swegym-rand48-s0.txt
HM_AGENT_TIMEOUT=1800
MAXRESP=8192
