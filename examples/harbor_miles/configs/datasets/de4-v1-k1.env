# eval-v2 de4-v1-k1 NORMAL (97 generated data-analysis tasks; NOT the *-protocol variant). Staged on hel, dfw, aws-iad:
# tasks at <user root>/miles/shared/tasks/de4-v1-k1-normal/harbor + the de-v2 SIF in <user root>/miles/shared/harbor_sif_images.
# Verifiers are deterministic (verify.py) but the task.toml templates need NVINF_API_KEY set (cluster-side ~/.secrets).
# Sandboxes: 4 CPU / 8 GB each (task.toml), agent timeout 3600 s, verifier 600 s; light on CPU (10-33 of 96 cores).
HARBOR_TASKS_DIR=${HM_USER_ROOT}/miles/shared/tasks/de4-v1-k1-normal/harbor
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/tasks/de4-v1-k1-normal-tasks.txt
HM_REQUIRE_ENV=NVINF_API_KEY
HM_AGENT_TIMEOUT=3600
AGENT_ENV='{"OMP_NUM_THREADS":"4","OPENBLAS_NUM_THREADS":"4","MKL_NUM_THREADS":"4","RCPP_PARALLEL_NUM_THREADS":"4"}'
