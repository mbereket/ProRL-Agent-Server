# DIAG 27B de4 OVERFIT, 2-NODE SAFE LAYOUT: trainer = node 0 (8 GPUs, TP4 x DP2) at 96k, rollout = node 1 (2 TP4 engines, 52 in flight).
# STACK (06:2x): REAL 96k packed steps OOM a 4-GPU TP4 trainer; 8-GPU TP4xDP2 fits 96k (73 GB, 13.2k tok/s). Same tasks/LR/recipe as -2n.
# Don't switch trainer layouts (DP 2 vs 1) mid-run: the distributed-optimizer state is DP-sharded.
RUN_NAME=diag-de4-27b-overfit8-t8
HARBOR_TASKS_DIR=${HM_USER_ROOT}/miles/shared/tasks/de4-v1-k1-normal/harbor
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/diag-de4-27b-overfit8.txt
HARNESS=codex
HF_CKPT=${HM_USER_ROOT}/miles/models/Qwen3.8-27B
MODEL_TYPE=qwen3.8-27B
TITO_MODEL=qwen38small
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder
AGENT_MODEL_NAME=qwen38-27b
ARM=lora
LORA_RANK=32
LORA_ALPHA=64
LORA_SERVE=merged
NO_MTP=1
LR=3e-5
LAYOUT=disagg
TRAIN_GPUS=8
TP=4
CP=1
MTPG=98304
ENGINE_TP=4
ENGINE_KV_TOKENS=1814546
MEMF=0.85
ASYNC=1
RBS=8
NS=8
MAX_STALENESS=2
NUM_ROLLOUT=40
MAX_SEQ_LEN=98304
HARBOR_MAX_SEQ_LEN=98304
SAVE_INTERVAL=1
DROP_ZERO_STD=1
HM_OVERLONG_REWARD=zero
MILES_RESPONSES_DEFAULT_MAX_TOKENS=0
ASYNC_CONCURRENCY=52
HM_SANDBOXES_PER_NODE=32
HM_AGENT_TIMEOUT=3600
HM_REAPER_EXEMPT_MINS=90
HM_AGENT_TOOLS=codex
HM_REQUIRE_ENV=NVINF_API_KEY
AGENT_ENV='{"OMP_NUM_THREADS":"4","OPENBLAS_NUM_THREADS":"4","MKL_NUM_THREADS":"4","RCPP_PARALLEL_NUM_THREADS":"4"}'
HM_CHAIN_MAX=8
HM_SANDBOX_RESERVE_CPUS=16
