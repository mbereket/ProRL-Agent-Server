# RECIPE DEFAULTS (layer 1 of 4: recipe > layout > dataset > experiment; setup/config.sh). Every run starts from these.
# Evidence for each value: miles-work/FINDINGS.md (entry in brackets). Change a value here only with new MEASURED evidence;
# a run that needs something else overrides it in its experiment file. launch/train_driver.sh's fallbacks equal these.

# --- LoRA, served merged
ARM=lora                    # LoRA is the primary mode
LORA_RANK=32                # r32 / alpha 64, all linear layers [LoRA]
LORA_ALPHA=64
LORA_TARGETS=all-linear
LORA_SERVE=merged           # train LoRA, serve W + (a/r)BA as a plain model: rollout -26-27 %, KL at the 2-3e-4 floor [D4 merged serving]
NO_MTP=1                    # bridge MTP layer dropped (base patch 0004); the MTP loss leaked into every update before [MTP loss]

# --- algorithm
LR=3e-5                     # provisional LR*: 1e-4 collapsed 9B lengths, 1e-5 slow; 27B 1e-4 hedge running [LR]
ASYNC=1                     # fully async rollouts (train_async.py --fully-async)
MAX_STALENESS=2             # groups may be <= 2 policy versions old [staleness]
DROP_ZERO_STD=1             # zero-variance groups dropped from the loss (smokes: 0) [zero-variance]
HM_OVERLONG_REWARD=zero     # a trajectory that ran out of context scores 0 and is trained [overlong policy]
RBS=8                       # tasks per step
NS=8                        # attempts per task (GRPO group size)
NUM_ROLLOUT=40              # steps; learning shows after ~10-13 steps at 3e-5, judge at >= 25-40 [D2]. Never change on resume.
SAVE_INTERVAL=1             # LoRA adapters are tiny: save every step (chained jobs resume from the newest)
# CAP (trajectory cap = SGLang context) has NO default: every experiment file must set it (de4: open between 96k and 128k+).

# --- harness and sandboxes
HARNESS=codex               # codex 0.125.0 via the session /v1/responses adapter; codex gets NO window (sessions end at the cap)
HM_AGENT_TOOLS=codex
MILES_RESPONSES_DEFAULT_MAX_TOKENS=0   # no per-call output cap: a turn stops at the context window -> overlong [codex window]
HM_AGENT_TIMEOUT=3600       # per-trial agent timeout s (smokes: 900)
HM_SANDBOX_RESERVE_CPUS=16  # sandboxes pinned off 16 job CPUs (SGLang/Ray/trainer stay responsive) [CPU starvation]
HM_REAPER_EXEMPT_MINS=90    # hel idle-GPU reaper: trainer GPUs idle while agents run

# --- job lifecycle
HM_CHAIN_MAX=8              # cluster-side chaining: each chunk queues its successor (afterany); stop: RUN_DIR/chain.stop
