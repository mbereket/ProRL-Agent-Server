# DIAG 27B de4 OVERFIT r3 (07:08, coordinator from STACK.md §13): 4-GPU TP4 CP1 trainer + 3 TP4 engines over 2 nodes, 96k cap.
# REAL 96k fits 4-GPU TP4 at full speed with --log-probs-chunk-size 1024 AND PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# (77.2 GB peak, 7.45k tok/s). 3 engines = ~1.5x rollout vs the 8-GPU-trainer layout (2 engines). Fresh RUN_NAME (no crash-loop
# history). The allocator env is exported before ray start (node_entry sources this config with set -a), so the trainer
# AND the SGLang engines inherit it. Watch engine start/CUDA graph capture too. Fallback on OOM: -2n-t8.env (TP4xCP2, 2 engines),
# fresh run (adapter shards are per-rank, so resume across 4->8 trainer GPUs isn't assumed to work).
RUN_NAME=diag-de4-27b-overfit8-r3
HARBOR_TASKS_DIR=${HM_USER_ROOT}/miles/shared/tasks/de4-v1-k1-normal/harbor
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/diag-de4-27b-overfit8.txt
HARNESS=codex
HF_CKPT=${HM_USER_ROOT}/miles/models/Qwen3.8-27B
MODEL_TYPE=qwen3.8-27B
TITO_MODEL=qwen38small
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder
AGENT_MODEL_NAME=qwen38-27b
ARM=lora
LORA_RANK=32
LORA_ALPHA=64
LORA_SERVE=merged
NO_MTP=1
LR=3e-5
LAYOUT=disagg
TRAIN_GPUS=4
TP=4
CP=1
MTPG=98304
ENGINE_TP=4
ENGINE_KV_TOKENS=1814546
MEMF=0.85
ASYNC=1
RBS=8
NS=8
MAX_STALENESS=2
NUM_ROLLOUT=40
MAX_SEQ_LEN=98304
HARBOR_MAX_SEQ_LEN=98304
SAVE_INTERVAL=1
DROP_ZERO_STD=1
HM_OVERLONG_REWARD=zero
MILES_RESPONSES_DEFAULT_MAX_TOKENS=0
ASYNC_CONCURRENCY=78
HM_SANDBOXES_PER_NODE=40
HM_AGENT_TIMEOUT=3600
HM_REAPER_EXEMPT_MINS=90
HM_AGENT_TOOLS=codex
HM_REQUIRE_ENV=NVINF_API_KEY
AGENT_ENV='{"OMP_NUM_THREADS":"4","OPENBLAS_NUM_THREADS":"4","MKL_NUM_THREADS":"4","RCPP_PARALLEL_NUM_THREADS":"4"}'
HM_CHAIN_MAX=8
HM_SANDBOX_RESERVE_CPUS=16
LOGPROB_CHUNK=1024
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
echo "[diag-cfg] $(hostname -s) PYTORCH_CUDA_ALLOC_CONF=${PYTORCH_CUDA_ALLOC_CONF} LOGPROB_CHUNK=${LOGPROB_CHUNK}" >&2
