# Same-harness STEP-0 BASELINE for the rand48 LR sweep (D2): the base model (LoRA B=0) evaluated by Path B's own eval
# (codex 0.125.0 through the session /v1/responses adapter, same sampling, overlong = 0, unfiltered) before any training.
# 48 tasks x 4 attempts (192 trials, SE ~.036) instead of x 2 for a tighter reference. 96 sandboxes (eval only; nothing
# else runs on the node). The job is cancelled once "eval 0:" lands; NUM_ROLLOUT=1 bounds it if the canceller dies.
RUN_NAME=swegym-codex-rand48-base-eval-r2
HARBOR_TASKS_DIR=${HM_SHARED}/tasks/swegym-lite-v3/harbor
TASK_IDS_FILE=${HM_EXAMPLE_DIR}/configs/swegym-rand48-s0.txt
HARNESS=codex
HF_CKPT=${HM_SHARED}/hf_home/hub/models--Qwen--Qwen3.5-9B/snapshots/c202236235762e1c871ad0ccb60c8ee5ba337b9a
ARM=lora
LORA_RANK=32
LORA_ALPHA=64
LR=1e-5
LAYOUT=disagg
TRAIN_GPUS=4
TP=4
CP=1
MTPG=65536
ENGINE_TP=2
MEMF=0.8
ASYNC=1
RBS=8
NS=8
MAX_STALENESS=2
NUM_ROLLOUT=1
MAX_SEQ_LEN=65536
MAXRESP=8192
SAVE_INTERVAL=2
DROP_ZERO_STD=1
HM_OVERLONG_REWARD=zero
EVAL_INTERVAL=5
EVAL_N=4
EVAL_BEFORE_TRAIN=1
EVAL_NAME=train48
HM_SANDBOXES_PER_NODE=96
HM_AGENT_TIMEOUT=1800
HM_REAPER_EXEMPT_MINS=60
HARBOR_MAX_SEQ_LEN=65536
HM_AGENT_TOOLS=codex
# Per-call max_new_tokens: pass through what codex sends (max_output_tokens), else none -> engine default
# (remaining context), exactly like Path A's gateway (H2H_SPEC: same per-call cap on both paths).
MILES_RESPONSES_DEFAULT_MAX_TOKENS=0
