# Qwen3.8-27B (dense, Qwen3.5-line GDN hybrid) on H100 80GB. Sourced by the 27b-* layouts.
HF_CKPT=${HM_USER_ROOT}/miles/models/Qwen3.8-27B   # stock weights (hel, dfw, aws-iad); Path B uses TITO, no template patch needed
MODEL_TYPE=qwen3.8-27B
TITO_MODEL=qwen38small
REASONING_PARSER=qwen3      # required: without the parsers the agent stops after one turn
TOOL_CALL_PARSER=qwen3_coder
AGENT_MODEL_NAME=qwen38-27b
MAX_TP=4                    # Megatron TP <= 4 (4 query groups)
GDN_KEY_HEADS=16            # headwise CP needs TP*CP | 16
# Rollout engine: TP4 (+40 % decode/GPU vs TP2; TP2 is KV-bound on de4), merged = plain bf16 engine.
ENGINE_TP=4
MEMF=0.85
ENGINE_KV_TOKENS=1814546    # SGLang max_total_num_tokens per TP4 engine at MEMF 0.85 (dfw 19608789)
# In-flight sessions per TP4 engine: the de4 KV knee is ~38 RUNNING sessions (de4 sessions hold ~50k KV tokens each) ->
# <= 35 in flight per engine (MEASURED, qwen27b STATUS "de4 ENGINE OPERATING POINT"; past the knee the prefix cache
# thrashes: hit 0.01-0.25, decode /2.5-3).
INFLIGHT_PER_ENGINE=32   # MEASURED de4 sweep (aws-iad 7599361): 32/engine = 92% of peak decode, KV max .67, no queue; knee 40-48 [F28]
KNEE_INFLIGHT_PER_ENGINE=35
