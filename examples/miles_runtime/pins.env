# shellcheck shell=bash
# Pinned inputs of the Miles runtime. Changing any of these changes the SIF path
# (the digest is part of the file name), so old and new runtimes coexist.
#
# radixark/miles:dev-202609302131 (== :latest on 2026-09-30), cu13 x86_64 variant:
# CUDA 13.0 / torch 2.13 / TE 2.17 / sglang-miles (from lmsysorg/sglang v0.5.20) /
# radixark Megatron-LM miles-main / Megatron-Bridge 8cd3466. The exact commits
# baked into the image are recorded by setup.sh in <stack>/images/<name>.versions.
MILES_IMAGE_REPO="${MILES_IMAGE_REPO:-radixark/miles}"
MILES_IMAGE_TAG="${MILES_IMAGE_TAG:-dev-202609302131}"
MILES_IMAGE_DIGEST="${MILES_IMAGE_DIGEST:-sha256:30bca3fc51a870a34aac7105627211ba42673dc2b7447f110b356d84bac1031b}"

# Unprivileged Apptainer (same pin and installer checksum as harbor_slime_grpo).
APPTAINER_VERSION="${APPTAINER_VERSION:-1.5.3}"
APPTAINER_INSTALLER_SHA256="${APPTAINER_INSTALLER_SHA256:-a097956eafa6ab3dd843ee429d0b774ed029753bfadf013b8046556228fac6f2}"

# CUDA forward-compat user-space driver for nodes whose kernel driver predates CUDA 13
# (dfw: 535 / CUDA 12.2; aws-iad: CUDA 12.x). Oldest CUDA-13 compat package NVIDIA publishes;
# the same one harbor_slime_grpo validated on dfw. Used automatically when the driver is < 580.
MILES_CUDA_COMPAT_VERSION="${MILES_CUDA_COMPAT_VERSION:-590.48.01_cuda13.1}"
