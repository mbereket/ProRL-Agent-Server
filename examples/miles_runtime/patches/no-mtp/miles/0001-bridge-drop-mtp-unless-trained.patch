diff -ru a/miles/backends/megatron_utils/lora/bridge.py b/miles/backends/megatron_utils/lora/bridge.py
--- a/miles/backends/megatron_utils/lora/bridge.py
+++ b/miles/backends/megatron_utils/lora/bridge.py
@@ -171,6 +171,12 @@
     if is_multi_lora_enabled(args):
         assert not args.enable_mtp_training, "Multi-LoRA does not support MTP training"
         provider.mtp_num_layers = None
+    if not getattr(args, "enable_mtp_training", False):
+        # HF configs with mtp_num_hidden_layers (Qwen3.5/3.6/3.8) otherwise build MTP layers whose
+        # cross-entropy loss is attached to the decoder output (MTPLossAutoScaler): an unweighted
+        # next-token loss on every rollout token leaks into the RL gradient, and its fp32
+        # [tokens x vocab/TP] logits dominate memory at long context.
+        provider.mtp_num_layers = None
     if is_multi_lora_enabled(args) and targets_expert_leaves(args.hf_lora_targets):
         # Expert adapters cannot replay the fused permute's row_id_map, and most bridge
         # MoE providers default the fusion on — so turn it off rather than refuse to build.
diff -ru a/miles/backends/megatron_utils/model_provider.py b/miles/backends/megatron_utils/model_provider.py
--- a/miles/backends/megatron_utils/model_provider.py
+++ b/miles/backends/megatron_utils/model_provider.py
@@ -52,6 +52,9 @@
     # Match the non-bridge path: MTP must only train its own draft parameters.
     if getattr(args, "enable_mtp_training", False):
         provider.mtp_detach_heads = True
+    else:
+        # Drop HF-config MTP layers unless MTP is trained (their loss would leak into the RL gradient).
+        provider.mtp_num_layers = None
 
     # numerics (training infra, not model-defining)
     provider.attention_softmax_in_fp32 = args.attention_softmax_in_fp32
